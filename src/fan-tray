COLOURS = [
    ("theme",    "Follow theme"),
    ("rainbow",  "Rainbow"),
    ("spinbow",  "Rainbow spin"),
    ("prism",    "Prism (per blade)"),
    ("heat",     "Heat — by temperature"),
