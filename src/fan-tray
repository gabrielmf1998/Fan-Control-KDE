def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write("%s  %s\n" % (datetime.datetime.now().strftime("%H:%M:%S"), msg))
    except OSError:
        pass


# --------------------------------------------------------------------- helper
def helper(*args, as_root=True):
    cmd = (["pkexec", HELPER] if as_root else [HELPER]) + list(args)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=40)
    except (OSError, subprocess.TimeoutExpired):
        return None


def boot_enabled():
    res = helper("boot", "status", as_root=False)
    return bool(res and res.stdout.strip() == "enabled")


# ------------------------------------------------------------------- painting
def _blades(p, r, count, span, skew, hub, colour):
    """Filled blades: fat shapes, because thin strokes vanish at 22 px."""
    outer = QRectF(-r, -r, 2 * r, 2 * r)
    inner = QRectF(-hub, -hub, 2 * hub, 2 * hub)
    p.setBrush(QBrush(colour))
    p.setPen(Qt.NoPen)
    for i in range(count):
        p.save()
        p.rotate(i * 360.0 / count)
        path = QPainterPath()
        path.arcMoveTo(outer, -span / 2.0)
        path.arcTo(outer, -span / 2.0, span)
        path.arcTo(inner, span / 2.0 + skew, -(span + skew))
        path.closeSubpath()
        p.drawPath(path)
        p.restore()


def _hub(p, r, colour, k=0.20):
    p.setPen(Qt.NoPen)
    p.setBrush(QBrush(colour))
    p.drawEllipse(QPointF(0, 0), r * k, r * k)


def draw_classic(p, r, c):
    _blades(p, r, 3, 58, 34, r * 0.20, c)
    _hub(p, r, c, 0.22)


def draw_turbine(p, r, c):
    p.setBrush(Qt.NoBrush)
    p.setPen(QPen(c, r * 0.11))
    p.drawEllipse(QPointF(0, 0), r * 0.97, r * 0.97)
    _blades(p, r * 0.84, 7, 40, 22, r * 0.24, c)
    _hub(p, r, c, 0.26)


def draw_pinwheel(p, r, c):
    _blades(p, r, 4, 62, 46, r * 0.16, c)
    _hub(p, r, c, 0.18)


def draw_casefan(p, r, c, angle):
    pen = QPen(c, r * 0.16)
    pen.setJoinStyle(Qt.MiterJoin)
    p.setPen(pen)
    p.setBrush(Qt.NoBrush)
    p.drawRoundedRect(QRectF(-r, -r, r * 2, r * 2), r * 0.24, r * 0.24)
    p.save()
    p.rotate(angle)
    _blades(p, r * 0.72, 5, 50, 30, r * 0.18, c)
    _hub(p, r, c, 0.20)
    p.restore()


def draw_blower(p, r, c):
    p.setBrush(Qt.NoBrush)
    p.setPen(QPen(c, r * 0.10))
    p.drawEllipse(QPointF(0, 0), r * 0.96, r * 0.96)
    p.setPen(QPen(c, r * 0.115, Qt.SolidLine, Qt.RoundCap))
    for i in range(14):
        p.save()
        p.rotate(i * 360.0 / 14)
        p.drawLine(QPointF(r * 0.52, 0), QPointF(r * 0.84, -r * 0.20))
        p.restore()
    _hub(p, r, c, 0.30)


def draw_ceiling(p, r, c):
    p.setPen(Qt.NoPen)
    p.setBrush(QBrush(c))
    for i in range(4):
        p.save()
        p.rotate(i * 90.0 + 12)
        path = QPainterPath()
        path.addRoundedRect(QRectF(r * 0.24, -r * 0.19, r * 0.76, r * 0.38),
                            r * 0.15, r * 0.15)
        p.drawPath(path)
        p.restore()
    _hub(p, r, c, 0.26)


def draw_impeller(p, r, c):
    p.setPen(QPen(c, r * 0.20, Qt.SolidLine, Qt.RoundCap))
    p.setBrush(Qt.NoBrush)
    for i in range(6):
        p.save()
        p.rotate(i * 60.0)
        path = QPainterPath()
        path.moveTo(r * 0.24, 0)
        path.cubicTo(r * 0.60, 0, r * 0.80, -r * 0.20, r * 0.92, -r * 0.52)
        p.drawPath(path)
        p.restore()
    _hub(p, r, c, 0.24)


def draw_hexfan(p, r, c, angle):
    pen = QPen(c, r * 0.15)
    pen.setJoinStyle(Qt.MiterJoin)
    p.setPen(pen)
    p.setBrush(Qt.NoBrush)
    p.drawPolygon(QPolygonF([
        QPointF(r * math.cos(math.radians(a)), r * math.sin(math.radians(a)))
        for a in range(0, 360, 60)]))
    p.save()
    p.rotate(angle)
    _blades(p, r * 0.66, 6, 44, 26, r * 0.18, c)
    _hub(p, r, c, 0.20)
    p.restore()


def draw_spiral(p, r, c):
    p.setPen(Qt.NoPen)
    p.setBrush(QBrush(c))
    for i in range(3):
        p.save()
        p.rotate(i * 120.0)
        path = QPainterPath()
        path.moveTo(0, -r * 0.17)
        path.cubicTo(r * 0.55, -r * 0.44, r * 0.92, -r * 0.30, r * 0.99, r * 0.06)
        path.cubicTo(r * 0.70, -r * 0.02, r * 0.42, r * 0.14, 0, r * 0.19)
        path.closeSubpath()
        p.drawPath(path)
        p.restore()
    _hub(p, r, c, 0.21)


# --- new in 1.2 -------------------------------------------------------------
def draw_triblade(p, r, c):
    """Three narrow swept blades, like a high-static-pressure fan."""
    _blades(p, r, 3, 30, 58, r * 0.14, c)
    _hub(p, r, c, 0.19)


def draw_jet(p, r, c):
    """Jet turbine seen head-on: a rim packed with thin blades."""
    p.setBrush(Qt.NoBrush)
    p.setPen(QPen(c, r * 0.09))
    p.drawEllipse(QPointF(0, 0), r * 0.98, r * 0.98)
    _blades(p, r * 0.90, 18, 13, 9, r * 0.30, c)
    p.setPen(QPen(c, r * 0.07))
    p.setBrush(Qt.NoBrush)
    p.drawEllipse(QPointF(0, 0), r * 0.32, r * 0.32)
    _hub(p, r, c, 0.16)


def draw_cog(p, r, c):
    """Gear wheel -- reads as machinery rather than airflow."""
    teeth = 10
    p.setPen(Qt.NoPen)
    p.setBrush(QBrush(c))
    path = QPainterPath()
    for i in range(teeth * 2):
        ang = math.radians(i * 180.0 / teeth)
        rad = r if i % 2 == 0 else r * 0.78
        pt = QPointF(rad * math.cos(ang), rad * math.sin(ang))
        path.lineTo(pt) if i else path.moveTo(pt)
    path.closeSubpath()
    p.drawPath(path)
    p.setBrush(Qt.NoBrush)
    p.setPen(QPen(QColor(0, 0, 0, 0), 0))
    # punch the middle out by drawing with the destination cleared
    p.setCompositionMode(QPainter.CompositionMode_Clear)
    p.setBrush(QBrush(Qt.black))
    p.setPen(Qt.NoPen)
    p.drawEllipse(QPointF(0, 0), r * 0.34, r * 0.34)
    p.setCompositionMode(QPainter.CompositionMode_SourceOver)


def draw_snowflake(p, r, c):
    """Six arms with branches: still legible when it is barely turning."""
    p.setPen(QPen(c, r * 0.13, Qt.SolidLine, Qt.RoundCap))
    for i in range(6):
        p.save()
        p.rotate(i * 60.0)
        p.drawLine(QPointF(0, 0), QPointF(r * 0.96, 0))
        p.drawLine(QPointF(r * 0.52, 0), QPointF(r * 0.76, -r * 0.30))
        p.drawLine(QPointF(r * 0.52, 0), QPointF(r * 0.76, r * 0.30))
        p.restore()
    _hub(p, r, c, 0.17)


def draw_vortex(p, r, c):
    """Five tapering arms curling out of the hub."""
    p.setPen(Qt.NoPen)
    p.setBrush(QBrush(c))
    for i in range(5):
        p.save()
        p.rotate(i * 72.0)
        path = QPainterPath()
        path.moveTo(0, -r * 0.14)
        path.cubicTo(r * 0.45, -r * 0.40, r * 0.86, -r * 0.34, r * 1.0, 0)
        path.cubicTo(r * 0.72, -r * 0.02, r * 0.38, r * 0.10, 0, r * 0.15)
        path.closeSubpath()
        p.drawPath(path)
        p.restore()
    _hub(p, r, c, 0.18)


def draw_orbit(p, r, c):
    """Three tilted rings around a core."""
    p.setBrush(Qt.NoBrush)
    p.setPen(QPen(c, r * 0.10))
    for i in range(3):
        p.save()
        p.rotate(i * 60.0)
        p.drawEllipse(QRectF(-r * 0.98, -r * 0.38, r * 1.96, r * 0.76))
        p.restore()
    _hub(p, r, c, 0.26)


