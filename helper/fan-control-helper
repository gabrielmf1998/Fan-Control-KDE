RUN_STATUS = os.path.join(RUN_DIR, "status.json")

BOOT_UNIT = "fan-control-kde-restore.service"
CURVE_UNIT = "fan-control-kde-curve.service"

SYSFS_HWMON = "/sys/class/hwmon"
SYSFS_DRM = "/sys/class/drm"

# Above this, every curve is overridden and the fan goes to 100%. A fan curve
