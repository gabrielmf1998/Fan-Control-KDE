# Above this, every curve is overridden and the fan goes to 100%. A fan curve
# is a comfort setting; this is not negotiable.
EMERGENCY_TEMP = 95.0
# What a curve falls back to when its temperature source stops answering.
# Deliberately loud: a silent fallback would be a silent overheat.
FALLBACK_PERCENT = 70
# How often the daemon looks at a fan it is holding at a set speed.
HOLD_CHECK_S = 2.0


# --------------------------------------------------------------------------
# sysfs
# --------------------------------------------------------------------------
def read_text(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def read_int(path, default=None):
    raw = read_text(path)
    try:
        return int(raw)
    except (TypeError, ValueError):
        return default


def write_raw(path, value):
    """None on success, otherwise a human-readable reason."""
    try:
        with open(path, "w") as fh:
            fh.write(str(value))
        return None
    except OSError as exc:
        if exc.errno == errno.EACCES and os.geteuid() != 0:
            return "needs root"
        if exc.errno == errno.EINVAL:
            return "the driver rejected %s" % value
        if exc.errno == errno.EOPNOTSUPP:
            return "not supported by this driver"
        return exc.strerror or str(exc)


def write_verified(path, value, settle=0.0, tolerance=0):
    """Write, then read back. A driver that quietly ignores a value is the
    normal failure here, not an exception: amdgpu and nvidia both do it.

    `tolerance` is for duty registers that do not read back exactly what was
    written - amdgpu reports the duty the fan controller is actually putting
    out, and older it87 chips keep seven bits of eight. Calling those a failure
    meant a speed that was applied was never saved."""
    err = write_raw(path, value)
    if err:
        return err
    if settle:
        time.sleep(settle)
    got = read_int(path)
    if got is not None and abs(int(got) - int(value)) > tolerance:
        return "the driver kept %s instead of %s" % (got, value)
    return None


def pct_to_raw(pct, lo, hi):
    return int(round(lo + (hi - lo) * max(0, min(100, pct)) / 100.0))


def raw_to_pct(raw, lo, hi):
    if raw is None or hi <= lo:
        return 0
    return int(round((raw - lo) * 100.0 / (hi - lo)))


def run(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


