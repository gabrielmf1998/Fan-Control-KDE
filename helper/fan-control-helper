#!/usr/bin/env python3
"""Root helper for Fan Control KDE.

Finds every fan controller the machine will admit to having, drives whichever
backend each one needs, and runs the daemon that keeps them there. Nothing
about the hardware is assumed: capabilities are probed, writes are read back,
and a device that cannot be driven is reported as monitor-only with the reason
rather than being hidden, so the user can see it exists and why it will not
move.

Commands
    status                       everything, as JSON
    sensors                      temperature sources only, as JSON
    set <id> <0-100|auto|full>   drive one fan, and keep it there
    curve show                   the stored curves
    curve set                    replace them, JSON on stdin
    curve enable <id> <on|off>   turn one curve on or off
    hwcurve <id> [reset]         push a curve into the firmware, or undo that
    calibrate <id>               sweep the fan and report what it actually does
    daemon                       run the service loop (this is the service)
    daemon <on|off|status>       enable, disable or query that service
    boot <on|off|status>         put the saved speeds back when it starts
    restore                      put them back now
    migrate                      carry an older install over (for packaging)
    version

Only `status`, `sensors`, `curve show` and the three `*/status` queries are
meant to run unprivileged; everything else needs root and says so.
"""
import ctypes
import errno
import glob
import json
import os
import re
import signal
import subprocess
import sys
import time

