# backends
# --------------------------------------------------------------------------
class Backend:
    kind = "unknown"
    control = False
    hw_curve = False

    def status(self):
        return {}

    def set(self, value):
        return False, "this device cannot be controlled"

    def features(self):
        return {}


# Per-chip enable values. Probing them at runtime would mean writing to a fan
# controller to see what happens, so they are a table with a verified fallback.
HWMON_QUIRKS = {
    # nct6775 family: 0 really is "no control, full speed", and Smart Fan IV
    # (5) is the mode that reads the auto_point curve.
    "nct6775": {"manual": 1, "auto": 5, "auto_alt": 2, "full": 0, "curve": 5},
    "it87":    {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "f71882fg": {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "dell_smm": {"manual": 1, "auto": 2, "auto_alt": 0, "full": None, "curve": None},
    "thinkpad": {"manual": 1, "auto": 2, "auto_alt": None, "full": 0, "curve": None},
    "applesmc": {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "amdgpu":  {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "default": {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
}

# Anything whose name starts with one of these uses that family's quirks.
QUIRK_PREFIXES = (("nct6", "nct6775"), ("w836", "nct6775"), ("it8", "it87"),
                  ("f718", "f71882fg"), ("f8", "f71882fg"),
                  ("dell", "dell_smm"), ("thinkpad", "thinkpad"))


def quirks_for(name):
    name = (name or "").lower()
    if name in HWMON_QUIRKS:
        return HWMON_QUIRKS[name]
    for prefix, key in QUIRK_PREFIXES:
        if name.startswith(prefix):
            return HWMON_QUIRKS[key]
    return HWMON_QUIRKS["default"]


class HwmonChannel(Backend):
    """One pwmN on one hwmon chip.

    Per channel rather than per chip: a board with a CPU header and five case
    headers is six independent fans, and ganging them together is exactly the
    control everybody actually wants back.
    """

    kind = "hwmon"
    control = True

    def __init__(self, path, channel, chip):
        self.path = path
        self.ch = channel
        self.chip = chip
        self.q = quirks_for(chip)
        # Set by discovery to the device id, so a backup can be found again.
        self.backup_key = ""

    def f(self, pattern):
        return os.path.join(self.path, pattern % self.ch)

    def bounds(self):
        lo = read_int(self.f("pwm%d_min"), 0) or 0
        hi = read_int(self.f("pwm%d_max"), 255) or 255
        if hi <= lo:
            lo, hi = 0, 255
        return lo, hi

    @property
    def has_hw_curve(self):
        return (self.q.get("curve") is not None
                and os.path.exists(self.f("pwm%d_auto_point1_pwm")))

    def temp_sources(self):
        """Which temperature the chip can pin this channel to, for its own
        hardware curve. The index is 1-based over the chip's temp inputs."""
        if not os.path.exists(self.f("pwm%d_temp_sel")):
            return []
        out = []
        for inp in sorted(glob.glob(os.path.join(self.path, "temp[0-9]*_input"))):
            idx = int(re.search(r"temp(\d+)_input", inp).group(1))
            label = read_text(inp.replace("_input", "_label")) or "temp%d" % idx
            value = read_int(inp)
            out.append({"index": idx, "label": label,
                        "temp": round(value / 1000.0, 1) if value else None})
        return out

    def mode(self):
        enable = read_int(self.f("pwm%d_enable"))
        if enable is None:
            return "unknown"
        if enable == self.q["manual"]:
            return "manual"
        if self.q["full"] is not None and enable == self.q["full"]:
            return "full"
        if self.q["curve"] is not None and enable == self.q["curve"]:
            return "hwcurve"
        return "auto"

    def status(self):
        lo, hi = self.bounds()
        raw = read_int(self.f("pwm%d"))
        mode = self.mode()
        st = {
            "raw": raw,
            "percent": 100 if mode == "full" else raw_to_pct(raw, lo, hi),
            "mode": mode,
            "rpm": read_int(self.f("fan%d_input")),
            "range": [0, 100],
            "enable": read_int(self.f("pwm%d_enable")),
        }
        st["rpms"] = [st["rpm"]] if st["rpm"] else []
        return st

    def features(self):
        return {
            "hw_curve": self.has_hw_curve,
            "temp_sel": self.temp_sources(),
            "dc_mode": read_int(self.f("pwm%d_mode")),
            "tach": os.path.exists(self.f("fan%d_input")),
        }

    def set(self, value):
        en, pw = self.f("pwm%d_enable"), self.f("pwm%d")
        if value == "auto":
            err = write_verified(en, self.q["auto"], settle=0.05)
            if err and self.q.get("auto_alt") is not None:
                err = write_verified(en, self.q["auto_alt"], settle=0.05)
            return (False, err) if err else (True, None)

        if value == "full":
            if self.q["full"] is not None:
                err = write_verified(en, self.q["full"], settle=0.05)
                if not err:
                    return True, None
            value = "100"

        try:
            pct = max(0, min(100, int(value)))
        except (TypeError, ValueError):
            return False, "not a percentage: %s" % value

        lo, hi = self.bounds()
        if pct >= 100 and self.q["full"] is not None:
            err = write_verified(en, self.q["full"], settle=0.05)
            if not err:
                return True, None
        err = write_verified(en, self.q["manual"], settle=0.05)
        if err:
            return False, err
        err = write_verified(pw, pct_to_raw(pct, lo, hi))
        return (False, err) if err else (True, None)

    # ---- the chip's own curve ------------------------------------------
    def read_hw_curve(self):
        if not self.has_hw_curve:
            return None
        points = []
        for i in range(1, 6):
            t = read_int(self.f("pwm%%d_auto_point%d_temp" % i))
            v = read_int(self.f("pwm%%d_auto_point%d_pwm" % i))
            if t is None or v is None:
                break
            lo, hi = self.bounds()
            points.append([round(t / 1000.0), raw_to_pct(v, lo, hi)])
        return {"points": points,
                "temp_sel": read_int(self.f("pwm%d_temp_sel")),
                "step_up_ms": read_int(self.f("pwm%d_step_up_time")),
                "step_down_ms": read_int(self.f("pwm%d_step_down_time"))}

    def raw_hw_state(self):
        """Exactly what is in the chip's anchor registers, for backing up."""
        if not self.has_hw_curve:
            return None
        points = []
        for i in range(1, 6):
            points.append([read_int(self.f("pwm%%d_auto_point%d_temp" % i)),
                           read_int(self.f("pwm%%d_auto_point%d_pwm" % i))])
        return {"raw_points": points,
                "temp_sel": read_int(self.f("pwm%d_temp_sel")),
                "enable": read_int(self.f("pwm%d_enable"))}

    def restore_hw_state(self, saved):
        for i, pair in enumerate(saved.get("raw_points") or [], start=1):
            temp, pwm = pair
            if temp is not None:
                write_raw(self.f("pwm%%d_auto_point%d_temp" % i), temp)
            if pwm is not None:
                write_raw(self.f("pwm%%d_auto_point%d_pwm" % i), pwm)
        if saved.get("temp_sel") is not None:
            write_raw(self.f("pwm%d_temp_sel"), saved["temp_sel"])
        if saved.get("enable") is not None:
            err = write_verified(self.f("pwm%d_enable"), saved["enable"],
                                 settle=0.05)
            if err:
                return False, err
        return True, "the firmware curve this chip had before is back"

    def write_hw_curve(self, points, temp_sel=None, floor_pct=None):
        """Resample a curve to the chip's five anchor points and commit it.

        The five have to rise; the driver rejects anything else. The last one is
        pinned high so a machine that walks off the end of the curve still gets
        every fan it has.
        """
        if not self.has_hw_curve:
            return False, "this chip has no hardware curve"
        lo, hi = self.bounds()
        temps = [p[0] for p in points]
        if len(temps) < 2:
            return False, "a curve needs at least two points"

        # five evenly spaced temperatures across the curve, then the critical one
        span_lo, span_hi = min(temps), max(temps)
        anchors = []
        for i in range(4):
            t = span_lo + (span_hi - span_lo) * i / 3.0
            anchors.append((round(t), curve_value(points, t)))
        anchors.append((127, 100))

        # strictly increasing temperatures, non-decreasing pwm
        fixed = []
        last_t, last_p = -1, 0
        for t, pct in anchors:
            t = max(int(t), last_t + 1)
            pct = max(int(round(pct)), last_p)
            if floor_pct is not None:
                pct = max(pct, int(floor_pct))
            fixed.append((t, min(100, pct)))
            last_t, last_p = t, pct

        # Only the first time: a second write would back up our own curve.
        backup = hwbackup_load()
        if self.backup_key and self.backup_key not in backup:
            saved = self.raw_hw_state()
            if saved:
                backup[self.backup_key] = saved
                hwbackup_save(backup)

        if temp_sel:
            err = write_raw(self.f("pwm%d_temp_sel"), int(temp_sel))
            if err:
                return False, "temperature source: %s" % err
        for i, (t, pct) in enumerate(fixed, start=1):
            err = write_raw(self.f("pwm%%d_auto_point%d_temp" % i), t * 1000)
            if err:
                return False, "point %d temperature: %s" % (i, err)
            err = write_raw(self.f("pwm%%d_auto_point%d_pwm" % i),
                            pct_to_raw(pct, lo, hi))
            if err:
                return False, "point %d speed: %s" % (i, err)
        err = write_verified(self.f("pwm%d_enable"), self.q["curve"], settle=0.05)
        if err:
            return False, err
        return True, "the chip is running the curve now: " + \
            ", ".join("%d°C→%d%%" % (t, p) for t, p in fixed)

    def reset_hw_curve(self):
        saved = hwbackup_load().pop(self.backup_key, None) if self.backup_key \
            else None
        if saved:
            ok, note = self.restore_hw_state(saved)
            if ok:
                remaining = hwbackup_load()
                remaining.pop(self.backup_key, None)
                hwbackup_save(remaining)
            return ok, note
        # Nothing was saved, so the honest answer is that the anchor points
        # cannot be un-written; the most that is left is handing the fan back
        # to the chip's automatic mode.
        ok, err = self.set("auto")
        return ok, (err if not ok else
                    "handed back to the chip's automatic mode, but the anchor "
                    "points this curve overwrote were not saved, so that is "
                    "what it is still following")


class AmdGpu(HwmonChannel):
    """amdgpu's hwmon pwm, plus RDNA3/4's own overdrive fan curve.

    On RDNA3 the firmware refuses flat manual control on many boards - the write
    lands and the card ignores it - so the overdrive curve is not a nicety here,
    it is the only control those cards have.
    """

    kind = "amdgpu"

    def __init__(self, path, channel, chip, od_dir=None):
        super().__init__(path, channel, chip)
        self.od = od_dir

    @property
    def has_hw_curve(self):
        return bool(self.od and os.path.exists(os.path.join(self.od, "fan_curve")))

    def od_file(self, name):
        return os.path.join(self.od, name) if self.od else None

    def read_hw_curve(self):
        if not self.has_hw_curve:
            return None
        raw = read_text(self.od_file("fan_curve")) or ""
        points, ranges = [], {}
        section = ""
        for line in raw.splitlines():
            line = line.strip()
            if line.startswith("OD_FAN_CURVE"):
                section = "curve"
                continue
            if line.startswith("OD_RANGE"):
                section = "range"
                continue
            if section == "curve":
                m = re.match(r"(\d+)\s*:\s*(\d+)C\s+(\d+)", line)
                if m:
                    points.append([int(m.group(2)), int(m.group(3))])
            elif section == "range":
                nums = re.findall(r"(\d+)", line)
                if "temp" in line.lower() and len(nums) >= 2:
                    ranges["temp"] = [int(nums[-2]), int(nums[-1])]
                elif "speed" in line.lower() and len(nums) >= 2:
                    ranges["speed"] = [int(nums[-2]), int(nums[-1])]
        out = {"points": points, "range": ranges}
        for extra in ("fan_minimum_pwm", "fan_target_temperature",
                      "fan_zero_rpm_enable", "fan_zero_rpm_stop_temperature",
                      "acoustic_limit_rpm_threshold",
                      "acoustic_target_rpm_threshold"):
            path = self.od_file(extra)
            if path and os.path.exists(path):
                out[extra] = read_text(path)
        return out

    def write_hw_curve(self, points, temp_sel=None, floor_pct=None):
        if not self.has_hw_curve:
            return False, ("this card has no overdrive fan curve; on RDNA3 and "
                           "newer it needs amdgpu.ppfeaturemask=0xffffffff on "
                           "the kernel command line")
        current = self.read_hw_curve() or {}
        slots = len(current.get("points") or []) or 5
        tlo, thi = (current.get("range", {}).get("temp") or [25, 100])
        slo, shi = (current.get("range", {}).get("speed") or [15, 100])

        temps = [p[0] for p in points]
        span_lo, span_hi = max(tlo, min(temps)), min(thi, max(temps))
        if span_hi <= span_lo:
            span_lo, span_hi = tlo, thi

        path = self.od_file("fan_curve")
        written = []
        for i in range(slots):
            t = span_lo + (span_hi - span_lo) * i / max(1, slots - 1)
            pct = curve_value(points, t)
            if floor_pct is not None:
                pct = max(pct, floor_pct)
            pct = int(max(slo, min(shi, round(pct))))
            t = int(max(tlo, min(thi, round(t))))
            err = write_raw(path, "%d %d %d" % (i, t, pct))
            if err:
                return False, "point %d: %s" % (i, err)
            written.append((t, pct))
        err = write_raw(path, "c")
        if err:
            return False, "commit: %s" % err
        return True, "the card is running the curve now: " + \
            ", ".join("%d°C→%d%%" % (t, p) for t, p in written)

    def reset_hw_curve(self):
        """amdgpu can restore its own defaults, which is better than any copy
        we could have kept: "r" then "c" puts the card's shipped curve back."""
        path = self.od_file("fan_curve")
        if path:
            err = write_raw(path, "r")
            if err:
                return False, err
            err = write_raw(path, "c")
            if err:
                return False, "commit: %s" % err
        backup = hwbackup_load()
        if self.backup_key in backup:
            backup.pop(self.backup_key, None)
            hwbackup_save(backup)
        ok, err = self.set("auto")
        return (ok, err) if not ok else (True, "the card's own fan curve is back")

    def features(self):
        f = super().features()
        f["hw_curve"] = self.has_hw_curve
        f["od_dir"] = self.od
        if self.has_hw_curve:
            f["zero_rpm"] = os.path.exists(self.od_file("fan_zero_rpm_enable"))
        return f

    def set(self, value):
        ok, err = super().set(value)
        if not ok:
            hint = ""
            if self.has_hw_curve:
                hint = ("; this card wants its overdrive fan curve instead of a "
                        "flat speed - set one in the Curves tab")
            elif os.path.exists("/sys/module/amdgpu/parameters/ppfeaturemask"):
                hint = ("; RDNA3 and newer need amdgpu.ppfeaturemask=0xffffffff "
                        "on the kernel command line for any fan control")
            return False, "%s%s" % (err, hint)
        return ok, err


class NvidiaGpu(Backend):
    """NVIDIA exposes no hwmon, so everything goes through nvidia-settings,
    which needs an X or XWayland display and Coolbits in the X configuration."""

    kind = "nvidia"
    control = True

    def __init__(self, index=0, name=""):
        self.index = index
        self.name = name

    def _q(self, attr):
        return nvidia_settings(["-q", attr])

    def bounds(self):
        """Ask the driver for its own limits. GeForce cards refuse anything
        under about 30%, and nvidia-settings exits 0 even when it refuses."""
        r = self._q("[fan:0]/GPUTargetFanSpeed")
        if r and r.returncode == 0:
            m = re.search(r"range\s+(\d+)\s*-\s*(\d+)", r.stdout)
            if m:
                return int(m.group(1)), int(m.group(2))
        return 30, 100

    def target(self):
        r = self._q("[fan:0]/GPUTargetFanSpeed")
        if r and r.returncode == 0:
            m = re.search(r"GPUTargetFanSpeed'\s*\([^)]*\):\s*(\d+)", r.stdout)
            if m:
                return int(m.group(1))
        return None

    def fan_count(self):
        r = self._q("[gpu:%d]/GPUFanCount" % self.index)
        if r and r.returncode == 0:
            m = re.search(r":\s*(\d+)", r.stdout)
            if m:
                return max(1, min(8, int(m.group(1))))
        return 2

    def rpms(self):
        out = []
        for fan in range(self.fan_count()):
            q = self._q("[fan:%d]/GPUCurrentFanSpeedRPM" % fan)
            if not q or q.returncode != 0:
                continue
            for line in q.stdout.splitlines():
                if "GPUCurrentFanSpeedRPM" in line and "):" in line:
                    digits = line.rsplit("):", 1)[1].strip().rstrip(".")
                    if digits.isdigit():
                        out.append(int(digits))
                    break
        return out

    def status(self):
        gpu = next((g for g in nvidia_gpus() if g["index"] == self.index), None)
        if gpu is None:
            return {"rpms": [], "percent": 0, "mode": "auto", "range": [30, 100],
                    "reason": "nvidia-smi is not answering"}
        r = self._q("[gpu:%d]/GPUFanControlState" % self.index)
        manual = bool(r and ": 1." in r.stdout)
        if r is None or r.returncode != 0:
            reason = ("nvidia-settings cannot reach a display; fan control needs "
                      "an X or XWayland session with Coolbits enabled")
        else:
            reason = ""
        return {
            "rpms": self.rpms(),
            "percent": gpu.get("fan") or 0,
            "temp": gpu.get("temp"),
            "util": gpu.get("util"),
            "mode": "manual" if manual else "auto",
            "range": list(self.bounds()),
            "reason": reason,
        }

    def features(self):
        return {"hw_curve": False, "fans": self.fan_count(),
                "needs_display": True}

    def set(self, value):
        if value == "auto":
            r = nvidia_settings(["-a", "[gpu:%d]/GPUFanControlState=0" % self.index])
            ok = r is not None and r.returncode == 0
            return ok, (None if ok else "nvidia-settings could not reach a display")

        if value == "full":
            value = "100"
        try:
            want = int(value)
        except (TypeError, ValueError):
            return False, "not a percentage: %s" % value

        lo, hi = self.bounds()
        pct = max(lo, min(hi, want))
        r = nvidia_settings(["-a", "[gpu:%d]/GPUFanControlState=1" % self.index])
        if r is None or r.returncode != 0:
            return False, ("could not enable manual fan control - Coolbits is "
                           "probably not set in the X configuration")
        for fan in range(self.fan_count()):
            nvidia_settings(["-a", "[fan:%d]/GPUTargetFanSpeed=%d" % (fan, pct)])

        got = self.target()          # exit codes from nvidia-settings mean nothing
        if got is None:
            return False, "could not read the fan speed back"
        if got != pct:
            return False, "the driver kept %d%% (asked for %d%%)" % (got, pct)
        if pct != want:
            return True, "clamped to %d%%: this GPU accepts %d-%d%%" % (pct, lo, hi)
        return True, None


class MonitorOnly(Backend):
    """Reports speed but cannot set it - Intel's discrete cards, mostly: the
    fan-speed PWM patches for xe are still out of tree."""

    kind = "monitor"
    control = False

    def __init__(self, path, reason):
        self.path = path
        self.reason = reason

    def status(self):
        rpms = []
        for f in sorted(glob.glob(os.path.join(self.path, "fan[0-9]*_input"))):
            v = read_int(f)
            if v is not None:
                rpms.append(v)
        return {"rpms": rpms, "percent": 0, "mode": "auto",
                "range": [0, 100], "reason": self.reason}


