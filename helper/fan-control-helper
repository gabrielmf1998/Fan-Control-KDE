CHIP_LABELS = {
    "k10temp": "CPU", "zenpower": "CPU", "coretemp": "CPU",
    "amdgpu": "GPU", "nouveau": "GPU", "i915": "GPU", "xe": "GPU",
    "nvme": "NVMe", "drivetemp": "Drive", "acpitz": "ACPI",
    "spd5118": "Memory", "iwlwifi_1": "Wi-Fi",
}

# Sensor labels that are the CPU on a Super I/O chip, in preference order.
CPU_SENSOR_HINTS = ("SMBUSMASTER 0", "TSI0_TEMP", "CPUTIN", "Tctl", "Tdie",
                    "Package id 0")

# A Super I/O chip wires more thermistor inputs than any board populates, and
# the empty ones do not read as absent - they read as 15 C, or 102 C, or 0. So
# a sensor is only trusted for "how hot is this machine" if it is either from a
# driver that knows what it is measuring, or a Super I/O input that boards
# actually connect. Everything stays selectable for a curve; this only decides
# what the icon panics about.
TRUSTED_CHIPS = ("k10temp", "zenpower", "coretemp", "amdgpu", "nouveau",
                 "i915", "xe", "nvidia", "nvme", "drivetemp")
TRUSTED_SUPERIO = ("SMBUSMASTER 0", "TSI0_TEMP", "CPUTIN", "SYSTIN",
                   "PECI Agent 0", "CPU Temperature")
PLAUSIBLE = (5.0, 120.0)


def sensor_trusted(chip, label, value):
    if not PLAUSIBLE[0] <= value <= PLAUSIBLE[1]:
        return False
    if chip in TRUSTED_CHIPS:
        return True
    return label in TRUSTED_SUPERIO


def chip_pretty(name):
    return CHIP_LABELS.get(name, name)


def hwmon_dirs():
    return sorted(glob.glob(os.path.join(SYSFS_HWMON, "hwmon*")),
                  key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0))


def hwmon_name(path):
    return read_text(os.path.join(path, "name")) or os.path.basename(path)


def is_gpu_hwmon(path):
    dev = os.path.realpath(os.path.join(path, "device"))
    return os.path.isdir(os.path.join(dev, "drm"))


def discover_sensors():
    """Every readable temperature on the machine, with a stable id.

    Keyed on chip name plus sensor label rather than the hwmon number, because
    that number is assigned in probe order and moves between boots.
    """
    out = []
    seen = {}
    for path in hwmon_dirs():
        name = hwmon_name(path)
        for inp in sorted(glob.glob(os.path.join(path, "temp[0-9]*_input"))):
            value = read_int(inp)
            if value is None:
                continue
            idx = re.search(r"temp(\d+)_input", inp).group(1)
            label = read_text(inp.replace("_input", "_label")) or "temp%s" % idx
            sid = "%s:%s" % (name, label)
            if sid in seen:                       # two sensors, one label
                seen[sid] += 1
                sid = "%s#%d" % (sid, seen[sid])
            else:
                seen[sid] = 1
            crit = read_int(inp.replace("_input", "_crit"))
            temp = round(value / 1000.0, 1)
            out.append({
                "id": sid,
                "label": "%s · %s" % (chip_pretty(name), label),
                "chip": name,
                "path": inp,
                "temp": temp,
                "crit": round(crit / 1000.0, 1) if crit else None,
                "trusted": sensor_trusted(name, label, temp),
            })

    for gpu in nvidia_gpus():
        temp = gpu.get("temp")
        if temp is not None:
            out.append({
                "id": "nvidia:%d" % gpu["index"],
                "label": "GPU · %s" % gpu["name"],
                "chip": "nvidia",
                "path": None,
                "temp": float(temp),
                "crit": None,
                "trusted": True,
            })
    return out


def sensor_value(sensors, sid):
    for s in sensors:
        if s["id"] == sid:
            return s["temp"]
    return None


# --------------------------------------------------------------------------
# NVIDIA
# --------------------------------------------------------------------------
_NVIDIA_CACHE = {"time": 0.0, "gpus": []}


def nvidia_gpus(max_age=2.0):
    """One nvidia-smi call, cached: discovery and the sensor list both want it."""
    now = time.monotonic()
    if now - _NVIDIA_CACHE["time"] < max_age:
        return _NVIDIA_CACHE["gpus"]
    gpus = []
    res = run(["nvidia-smi",
               "--query-gpu=index,name,fan.speed,temperature.gpu,utilization.gpu",
               "--format=csv,noheader,nounits"], timeout=8)
    if res and res.returncode == 0:
        for line in res.stdout.splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) < 5 or not parts[0].isdigit():
                continue
            gpus.append({
                "index": int(parts[0]),
                "name": parts[1],
                "fan": int(parts[2]) if parts[2].isdigit() else None,
                "temp": int(parts[3]) if parts[3].isdigit() else None,
                "util": int(parts[4]) if parts[4].isdigit() else 0,
            })
    _NVIDIA_CACHE.update(time=now, gpus=gpus)
    return gpus


def nvidia_env():
    env = dict(os.environ)
    env.setdefault("DISPLAY", ":0")
    # resolved fresh every call: right after boot the file may not exist yet
    xauth = sorted(glob.glob("/run/user/*/xauth_*"), key=os.path.getmtime,
                   reverse=True)
    if xauth:
        env["XAUTHORITY"] = xauth[0]
    return env


def nvidia_settings(args, timeout=15):
    try:
        return subprocess.run(["nvidia-settings"] + args, env=nvidia_env(),
                              capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


