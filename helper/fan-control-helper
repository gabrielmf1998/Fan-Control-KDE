# discovery
# --------------------------------------------------------------------------
def pci_name(slot):
    """A readable name for a PCI device, e.g. 'AMD Radeon RX 9070 XT'."""
    out = run(["lspci", "-mm", "-s", slot], timeout=5)
    if not out or out.returncode != 0:
        return None
    fields = re.findall(r'"([^"]*)"', out.stdout)
    if len(fields) < 3:
        return None
    vendor, device = fields[1], fields[2]
    vendor = vendor.split()[0].strip(",")
    inner = re.search(r"\[([^\]]+)\]\s*$", device)
    if inner:
        device = inner.group(1)
    for noise in ("Lite Hash Rate", "LHR", "OEM"):
        device = device.replace(noise, "")
    device = re.sub(r"\s*\(rev [^)]*\)", "", device)
    device = re.sub(r"\s{2,}", " ", device).strip(" /-")
    if vendor.lower().startswith(("advanced", "ati")):
        vendor = "AMD"
    return ("%s %s" % (vendor, device)).strip()


def header_label(channel):
    """A guess at what a motherboard header is for, which the user can rename.

    Channel 1 is the CPU header on every Super I/O layout worth naming, and the
    rest are chassis headers in order.
    """
    return "CPU fan" if channel == 1 else "Fan header %d" % channel


def gpu_od_dir(dev_path):
    d = os.path.join(dev_path, "gpu_od", "fan_ctrl")
    return d if os.path.isdir(d) else None


def hwmon_of(device_path):
    for h in sorted(glob.glob(os.path.join(device_path, "hwmon", "hwmon*"))):
        return h
    return None


def discover():
    devices = []
    used_names = {}

    # ---- motherboard and anything else with pwm that is not a GPU --------
    for path in hwmon_dirs():
        if is_gpu_hwmon(path):
            continue
        channels = sorted(int(re.search(r"pwm(\d+)$", p).group(1))
                          for p in glob.glob(os.path.join(path, "pwm[0-9]*"))
                          if re.search(r"pwm\d+$", p))
        if not channels:
            continue
        name = hwmon_name(path)
        used_names[name] = used_names.get(name, 0) + 1
        suffix = "" if used_names[name] == 1 else "#%d" % used_names[name]
        for ch in channels:
            backend = HwmonChannel(path, ch, name)
            backend.backup_key = "hwmon:%s%s:pwm%d" % (name, suffix, ch)
            devices.append({
                "id": "hwmon:%s%s:pwm%d" % (name, suffix, ch),
                "label": header_label(ch),
                "detail": "%s · pwm%d" % (name, ch),
                "kind": "cpu" if ch == 1 else "case",
                "backend": backend,
                "temp_hint": pick_cpu_sensor,
            })

    # ---- GPUs -----------------------------------------------------------
    for card in sorted(glob.glob(os.path.join(SYSFS_DRM, "card[0-9]*"))):
        if "-" in os.path.basename(card):            # card1-DP-1 and friends
            continue
        dev = os.path.realpath(os.path.join(card, "device"))
        if not os.path.isdir(dev):
            continue
        driver = os.path.basename(os.path.realpath(os.path.join(dev, "driver")))
        slot = os.path.basename(dev)

        if driver == "nvidia":
            continue                                  # handled through NVML

        hw = hwmon_of(dev)
        if not hw:
            continue
        channels = sorted(int(re.search(r"pwm(\d+)$", p).group(1))
                          for p in glob.glob(os.path.join(hw, "pwm[0-9]*"))
                          if re.search(r"pwm\d+$", p))
        has_tach = bool(glob.glob(os.path.join(hw, "fan[0-9]*_input")))
        od = gpu_od_dir(dev)
        if not (channels or has_tach or od):
            continue                                  # an iGPU: no fan at all
        # Only now: lspci is a process per card, and this runs on every poll.
        label = pci_name(slot.replace("0000:", "")) or driver

        if channels:
            chip = hwmon_name(hw)
            for ch in channels:
                backend = (AmdGpu(hw, ch, chip, od) if driver == "amdgpu"
                           else HwmonChannel(hw, ch, chip))
                backend.backup_key = ("gpu:%s:pwm%d" % (slot, ch)
                                      if len(channels) > 1 else "gpu:%s" % slot)
                devices.append({
                    "id": "gpu:%s:pwm%d" % (slot, ch) if len(channels) > 1
                          else "gpu:%s" % slot,
                    "label": label,
                    "detail": "%s · %s" % (driver, slot),
                    "kind": "gpu",
                    "backend": backend,
                    "temp_hint": lambda s, p=hw: hwmon_pick(s, p),
                })
        elif has_tach:
            reason = ("the %s driver reports fan speed but exposes no PWM "
                      "control; the patches for that are not in mainline yet"
                      % driver)
            devices.append({
                "id": "gpu:%s" % slot, "label": label,
                "detail": "%s · %s" % (driver, slot), "kind": "gpu",
                "backend": MonitorOnly(hw, reason), "temp_hint": None,
            })
        elif od:
            # A card with an overdrive curve but no pwm channel: RDNA3 boards
            # whose firmware exposes the curve and nothing else.
            backend = AmdGpu(hw, 1, hwmon_name(hw), od)
            backend.backup_key = "gpu:%s" % slot
            devices.append({
                "id": "gpu:%s" % slot, "label": label,
                "detail": "%s · %s" % (driver, slot), "kind": "gpu",
                "backend": backend,
                "temp_hint": lambda s, p=hw: hwmon_pick(s, p),
            })

    for gpu in nvidia_gpus():
        devices.append({
            "id": "nvidia:%d" % gpu["index"],
            "label": gpu["name"],
            "detail": "nvidia-settings",
            "kind": "gpu",
            "backend": NvidiaGpu(gpu["index"], gpu["name"]),
            "temp_hint": lambda s, i=gpu["index"]: "nvidia:%d" % i,
        })

    return devices


def pick_cpu_sensor(sensors):
    """The sensor a CPU-header curve should follow, if nobody chose one."""
    for hint in CPU_SENSOR_HINTS:
        for s in sensors:
            if s["id"].endswith(":" + hint):
                return s["id"]
    for s in sensors:
        if s["chip"] in ("k10temp", "zenpower", "coretemp"):
            return s["id"]
    return sensors[0]["id"] if sensors else None


def hwmon_pick(sensors, path):
    """The hottest-named sensor belonging to one hwmon directory."""
    prefer = ("junction", "hotspot", "edge", "mem")
    name = hwmon_name(path)
    mine = [s for s in sensors if s["chip"] == name]
    for key in prefer:
        for s in mine:
            if s["id"].lower().endswith(":" + key):
                return s["id"]
    return mine[0]["id"] if mine else None


def device_status(dev, sensors):
    st = dict(dev["backend"].status())
    st.update({
        "id": dev["id"], "label": dev["label"], "detail": dev["detail"],
        "kind": dev["kind"], "control": dev["backend"].control,
        "backend": dev["backend"].kind,
        "features": dev["backend"].features(),
    })
    st.setdefault("rpms", [])
    if st.get("temp") is None and dev.get("temp_hint"):
        try:
            sid = dev["temp_hint"](sensors)
        except TypeError:
            sid = None
        if sid:
            st["temp"] = sensor_value(sensors, sid)
            st["temp_source"] = sid
    hw = getattr(dev["backend"], "read_hw_curve", lambda: None)()
    if hw:
        st["hw_curve"] = hw
    return st


# --------------------------------------------------------------------------
# curves
# --------------------------------------------------------------------------
CURVE_DEFAULTS = {
    "enabled": False,
    "source": "",            # sensor id; empty means the device's own sensor
    "points": [[30, 25], [50, 40], [65, 65], [80, 100]],
    "hysteresis": 3.0,       # °C the temperature has to fall before we ease off
    "min_percent": 0,
    "max_percent": 100,
    "spinup_percent": 45,    # kick to get a stopped fan turning
    "spinup_ms": 900,
    "zero_below": 0,         # stop the fan below this temperature; 0 disables
    "ramp_up": 40,           # percentage points per second, going up
    "ramp_down": 8,          # and coming down, deliberately slower
}


def curve_value(points, temp):
    """Linear interpolation between the points, flat outside them."""
    pts = sorted((float(t), float(v)) for t, v in points)
    if not pts:
        return 0.0
    if temp <= pts[0][0]:
        return pts[0][1]
    if temp >= pts[-1][0]:
        return pts[-1][1]
    for (t0, v0), (t1, v1) in zip(pts, pts[1:]):
        if t0 <= temp <= t1:
            if t1 == t0:
                return v1
            return v0 + (v1 - v0) * (temp - t0) / (t1 - t0)
    return pts[-1][1]


def curves_load():
    try:
        with open(CURVES) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {"version": 1, "interval_ms": 1000, "curves": {}}
    if not isinstance(data, dict):
        return {"version": 1, "interval_ms": 1000, "curves": {}}
    data.setdefault("version", 1)
    data.setdefault("interval_ms", 1000)
    data.setdefault("curves", {})
    return data


def curve_for(store, dev_id):
    c = dict(CURVE_DEFAULTS)
    c.update(store.get("curves", {}).get(dev_id) or {})
    return c


def write_json(path, data):
    """Atomically, so a power cut mid-write leaves the old file rather than half
    of a new one. (None, or the reason it failed.)"""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError as exc:
        return exc.strerror or str(exc)
    return None


def curves_save(data):
    if os.geteuid() != 0:
        return False, "needs root"
    try:
        interval = int(max(200, min(10000, float(data.get("interval_ms", 1000)))))
    except (TypeError, ValueError):
        interval = 1000
    clean = {"version": 1, "interval_ms": interval, "curves": {}}
    for dev_id, raw in (data.get("curves") or {}).items():
        if not isinstance(raw, dict):
            continue
        c = dict(CURVE_DEFAULTS)
        for key in CURVE_DEFAULTS:
            if key in raw:
                c[key] = raw[key]
        points = []
        for pair in c["points"] if isinstance(c["points"], list) else []:
            try:
                t, v = float(pair[0]), float(pair[1])
            except (TypeError, ValueError, IndexError):
                continue
            points.append([max(0.0, min(120.0, t)), max(0.0, min(100.0, v))])
        if len(points) < 2:
            return False, "%s: a curve needs at least two points" % dev_id
        c["points"] = sorted(points)
        try:
            c["enabled"] = bool(c["enabled"])
            c["source"] = str(c["source"] or "")
            c["min_percent"] = int(max(0, min(100, float(c["min_percent"]))))
            c["max_percent"] = int(max(c["min_percent"], min(100, float(c["max_percent"]))))
            c["hysteresis"] = float(max(0.0, min(20.0, float(c["hysteresis"]))))
            c["spinup_percent"] = int(max(0, min(100, float(c["spinup_percent"]))))
            c["spinup_ms"] = int(max(0, min(5000, float(c["spinup_ms"]))))
            c["zero_below"] = int(max(0, min(90, float(c["zero_below"]))))
            c["ramp_up"] = float(max(1.0, min(100.0, float(c["ramp_up"]))))
            c["ramp_down"] = float(max(1.0, min(100.0, float(c["ramp_down"]))))
        except (TypeError, ValueError):
            return False, "%s: something in that curve is not a number" % dev_id
        clean["curves"][dev_id] = c
    err = write_json(CURVES, clean)
    return (False, err) if err else (True, None)


