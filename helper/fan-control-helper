def state_load():
    try:
        with open(STATE) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def state_save(data):
    if os.geteuid() != 0:
        return False
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(STATE, "w") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
        return True
    except OSError:
        return False


def hwbackup_load():
    try:
        with open(HWBACKUP) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def hwbackup_save(data):
    if os.geteuid() != 0:
        return False
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(HWBACKUP, "w") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
        return True
    except OSError:
        return False


def migrate_state(devices):
    """Version 1 keyed speeds as "cpu"/"gpu", then as "mb:<chip>". Map both onto
    the per-channel ids once, so an upgrade keeps what the user chose."""
    if os.geteuid() != 0:
        return
    saved = state_load()
    if not saved:
        return
    changed = False
    for legacy in list(saved):
        if legacy.startswith("hwmon:") or legacy.startswith("nvidia:"):
            continue
        value = saved[legacy]
        if legacy.startswith("mb:"):
            chip = legacy.split(":", 1)[1]
            targets = [d for d in devices if d["id"].startswith("hwmon:%s" % chip)]
        elif legacy == "cpu":
            targets = [d for d in devices if d["kind"] == "cpu"]
        elif legacy == "gpu" or legacy.startswith("gpu:"):
            targets = [d for d in devices if d["kind"] == "gpu"]
        else:
            continue
        for dev in targets:
            saved.setdefault(dev["id"], value)
        saved.pop(legacy, None)
        changed = True
    if changed:
        state_save(saved)


# --------------------------------------------------------------------------
# systemd
# --------------------------------------------------------------------------
def unit_enabled(unit):
    r = run(["systemctl", "is-enabled", unit], timeout=6)
    return (r.stdout.strip() if r else "") or "disabled"


def unit_active(unit):
    r = run(["systemctl", "is-active", unit], timeout=6)
    return (r.stdout.strip() if r else "") or "inactive"


def unit_set(unit, on, start=True):
    action = ["enable", "--now"] if (on and start) else \
             ["disable", "--now"] if start else \
             ["enable"] if on else ["disable"]
    r = run(["systemctl"] + action + [unit], timeout=30)
    if r is None:
        return 1, "systemctl did not answer"
    return r.returncode, (r.stderr or "").strip()


