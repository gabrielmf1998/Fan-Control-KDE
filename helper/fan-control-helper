# the daemon
# --------------------------------------------------------------------------
class CurveRunner:
    """One fan under one curve: hysteresis, ramping, spin-up and a floor.

    The level being ramped is kept as a float and only rounded on its way to
    the fan. Rounding it in place meant a step under half a percent - a slow
    ramp checked often - rounded straight back to where it started, and the fan
    never got to where the curve was sending it.
    """

    def __init__(self, dev, curve, source, interval=1.0, start=None):
        self.dev = dev
        self.curve = curve
        self.source = source
        self.interval = interval
        self.applied_temp = None
        # Where the fan is when the curve takes it, so the first move is a
        # ramp from there rather than a jump, and a fan that is already turning
        # does not get kicked as if it were standing still.
        self.level = start
        self.written = None
        self.spinup_until = 0.0

    def target(self, temp, now):
        c = self.curve
        # hysteresis: rise at once, fall only after the temperature really has
        if self.applied_temp is None or temp > self.applied_temp:
            self.applied_temp = temp
        elif temp < self.applied_temp - c["hysteresis"]:
            self.applied_temp = temp
        eff = self.applied_temp

        if c["zero_below"] and eff < c["zero_below"]:
            want = 0.0
        else:
            want = curve_value(c["points"], eff)
            want = max(c["min_percent"], min(c["max_percent"], want))

        if temp >= EMERGENCY_TEMP:
            self.level = 100.0
            return 100.0, "emergency"

        if self.level is None:
            self.level = want
        # a fan that is stopped needs a shove before it will take a low duty
        if want > 0 and self.level <= 0 and c["spinup_percent"] > 0:
            self.spinup_until = now + c["spinup_ms"] / 1000.0
        if now < self.spinup_until:
            self.level = max(want, float(c["spinup_percent"]))
            return self.level, "spin-up"

        # ramp: limit how far it may move in one interval
        limit = c["ramp_up"] if want > self.level else c["ramp_down"]
        step = limit * self.interval
        self.level = max(self.level - step, min(self.level + step, want))
        return self.level, "curve"


def calibration_marker(dev_id):
    return os.path.join(CALIBRATING_DIR, re.sub(r"[^A-Za-z0-9_.#:-]", "_", dev_id))


class Daemon:
    """The one service: it keeps the speeds that were set, puts them back when
    it starts, and runs the curves.

    A speed is not written once and trusted. On an ASRock B650 board the
    headers went back to 30% a few seconds after every boot, long after the
    old one-shot restore had finished and reported success, and firmware, a
    driver or some other tool can do the same at any time. So every fan this
    owns is looked at every couple of seconds and put back when it has moved,
    and the journal says each time that happened.
    """

    def __init__(self):
        self.quit = None
        self.started = time.time()
        self.devices = []
        self.by_id = {}
        self.store = {}
        self.state = {}
        self.interval = 1.0
        self.runners = {}      # dev_id -> CurveRunner
        self.held = {}         # dev_id -> the speed being kept
        self.wanted = {}       # what the last reload asked for, "auto" included
        self.initial = None    # the saved speeds as they were at start
        self.restore = True    # whether those came back at start
        self.put_back = {}     # dev_id -> how many times something moved it
        self.touched = set()   # fans a curve has driven: handed back on exit
        self.next_check = {}   # dev_id -> when to look at it again
        self.next_look = 0.0   # when to look again for fans not found yet
        self.stamps = None

    # ---- files and devices -------------------------------------------------
    @staticmethod
    def _stamp(path):
        try:
            st = os.stat(path)
            return (st.st_mtime_ns, st.st_size, st.st_ino)
        except OSError:
            return None

    def files_changed(self):
        stamps = (self._stamp(CURVES), self._stamp(STATE))
        if stamps == self.stamps:
            return False
        self.stamps = stamps
        return True

    def discover(self):
        self.devices = discover()
        self.by_id = {d["id"]: d for d in self.devices}

    def missing(self):
        """Fans there are orders for that have not turned up. A GPU driver or a
        Super I/O module can load after this starts; they get looked for."""
        ids = set(self.wanted) | {i for i, c in (self.store.get("curves") or {}).items()
                                  if isinstance(c, dict) and c.get("enabled")}
        ids |= set((self.state.get("speeds") or {}))
        return sorted(i for i in ids if i not in self.by_id)

    def calibrating(self, dev_id):
        try:
            return time.time() - os.path.getmtime(calibration_marker(dev_id)) < 600
        except OSError:
            return False

    def current_percent(self, dev_id):
        try:
            st = self.by_id[dev_id]["backend"].status()
        except Exception:                               # noqa: BLE001
            return None
        if st.get("mode") == "full":
            return 100.0
        pct = st.get("percent")
        return float(pct) if pct is not None else None

    # ---- what to do ----------------------------------------------------------
    def reload(self):
        self.store = curves_load()
        self.state = state_load()
        try:
            self.interval = max(0.2, float(self.store.get("interval_ms", 1000)) / 1000.0)
        except (TypeError, ValueError):
            self.interval = 1.0

        # the curves that should be running
        sensors = None
        curves = {}
        for dev_id, raw in (self.store.get("curves") or {}).items():
            if not isinstance(raw, dict) or not raw.get("enabled"):
                continue
            dev = self.by_id.get(dev_id)
            if not dev or not dev["backend"].control:
                continue
            curve = dict(CURVE_DEFAULTS)
            curve.update(raw)
            source = curve.get("source") or ""
            if not source and dev.get("temp_hint"):
                if sensors is None:
                    sensors = discover_sensors()
                try:
                    source = dev["temp_hint"](sensors)
                except TypeError:
                    source = None
            if source:
                curves[dev_id] = (curve, source)

        stopped = [i for i in self.runners if i not in curves]
        for dev_id in stopped:
            del self.runners[dev_id]
        for dev_id, (curve, source) in curves.items():
            old = self.runners.get(dev_id)
            if old and old.curve == curve and old.source == source:
                old.interval = self.interval
                continue
            start = old.level if old else self.current_percent(dev_id)
            self.runners[dev_id] = CurveRunner(self.by_id[dev_id], curve, source,
                                               self.interval, start)
            if old is None:
                log("%s: running its curve, following %s" % (dev_id, source))

        # the speeds set by hand
        speeds = self.state.get("speeds") or {}
        set_at = self.state.get("set_at") or {}
        entries = {i: (v, set_at.get(i)) for i, v in speeds.items()}
        first = self.initial is None
        if first:
            self.initial = entries
            self.restore = bool(self.state.get("restore_at_boot", True))
        wanted = {}
        for dev_id, (value, _when) in entries.items():
            if dev_id in self.runners:
                continue
            # From before this start, and putting those back is switched off.
            if not self.restore and entries[dev_id] == self.initial.get(dev_id):
                continue
            wanted[dev_id] = value
        for dev_id, value in wanted.items():
            if first or self.wanted.get(dev_id) != value:
                self.apply(dev_id, value, "put back" if first else "set")
        # A curve that was switched off and left nothing set by hand behind it
        # hands its fan back to the firmware, rather than leaving it wherever
        # the curve last had it.
        for dev_id in stopped:
            if dev_id not in wanted and dev_id in self.touched:
                self.apply(dev_id, "auto", "its curve was switched off")
            self.touched.discard(dev_id)
        self.wanted = wanted
        self.held = {i: v for i, v in wanted.items() if v != "auto"}

    def apply(self, dev_id, value, why):
        dev = self.by_id.get(dev_id)
        if dev is None or self.calibrating(dev_id):
            return
        backend = dev["backend"]
        self.next_check[dev_id] = time.monotonic() + backend.check_every
        if backend.matches(value):
            return
        ok, note = backend.set(value)
        if ok:
            log("%s -> %s (%s)%s" % (dev_id, value, why, "; " + note if note else ""))
        else:
            log("%s -> %s (%s) FAILED: %s" % (dev_id, value, why, note))

    def keep(self, now, report):
        """Put back whatever has been moved off the speed it was set to."""
        for dev_id, value in self.held.items():
            dev = self.by_id.get(dev_id)
            if dev is None:
                continue
            info = {"value": value, "put_back": self.put_back.get(dev_id, 0),
                    "label": dev["label"]}
            report["held"][dev_id] = info
            if self.calibrating(dev_id) or now < self.next_check.get(dev_id, 0.0):
                continue
            backend = dev["backend"]
            self.next_check[dev_id] = now + backend.check_every
            if backend.matches(value):
                continue
            st = backend.status()
            was = "%s at %s%%" % (st.get("mode", "?"), st.get("percent", "?"))
            count = self.put_back.get(dev_id, 0) + 1
            self.put_back[dev_id] = info["put_back"] = count
            ok, note = backend.set(value)
            if count <= 5 or count % 100 == 0:
                log("%s had been moved off %s (it was %s); %s%s" % (
                    dev_id, value, was,
                    "put it back" if ok else "could not put it back: %s" % note,
                    "" if count == 1 else " - %d times so far" % count))

    def tick_curves(self, now, sensors, report):
        for dev_id, runner in self.runners.items():
            if self.calibrating(dev_id):
                report["fans"][dev_id] = {"percent": runner.written, "temp": None,
                                          "source": runner.source, "why": "calibrating",
                                          "label": runner.dev["label"]}
                continue
            temp = sensor_value(sensors, runner.source)
            if temp is None:
                level, why = float(FALLBACK_PERCENT), "no sensor"
                runner.level = level
            else:
                level, why = runner.target(temp, now)
            pct = int(round(level))
            backend = runner.dev["backend"]
            moved = False
            if runner.written == pct and now >= self.next_check.get(dev_id, 0.0):
                self.next_check[dev_id] = now + backend.check_every
                moved = not backend.matches(str(pct))
            if runner.written != pct or moved:
                ok, note = backend.set(str(pct))
                if ok:
                    if moved:
                        log("%s had been moved off its curve's %d%%; put it back"
                            % (dev_id, pct))
                    runner.written = pct
                    self.touched.add(dev_id)
                else:
                    why = "failed: %s" % note
            report["fans"][dev_id] = {
                "percent": runner.written, "temp": temp, "source": runner.source,
                "why": why, "label": runner.dev["label"],
            }

    # ---- the loop ------------------------------------------------------------
    def run(self):
        if os.geteuid() != 0:
            print("the daemon needs root", file=sys.stderr)
            return 1
        import threading
        self.quit = threading.Event()

        def _stop(_sig, _frame):
            self.quit.set()

        signal.signal(signal.SIGTERM, _stop)
        signal.signal(signal.SIGINT, _stop)
        try:
            os.makedirs(RUN_DIR, exist_ok=True)
            os.chmod(RUN_DIR, 0o755)
        except OSError:
            pass

        self.discover()
        migrate_state(self.devices)
        self.files_changed()
        self.reload()
        log("started: %d fan(s) kept at a set speed, %d curve(s) running%s" % (
            len(self.held), len(self.runners),
            "" if self.restore else "; saved speeds are not put back at start"))

        while not self.quit.is_set():
            try:
                now = time.monotonic()
                if self.files_changed():
                    self.reload()
                    log("settings changed: %d kept, %d curve(s)"
                        % (len(self.held), len(self.runners)))
                missing = self.missing()
                if missing and now >= self.next_look:
                    self.discover()
                    self.next_look = now + (5.0 if time.time() - self.started < 180
                                            else 60.0)
                    found = [i for i in missing if i in self.by_id]
                    if found:
                        log("found %s" % ", ".join(found))
                        self.reload()
                sensors = discover_sensors() if self.runners else []
                report = {"time": time.time(), "pid": os.getpid(),
                          "fans": {}, "held": {}}
                self.tick_curves(now, sensors, report)
                self.keep(now, report)
                write_status(report)
            except Exception as exc:                    # a loop that dies is worse
                log("daemon error: %r" % exc)
            self.quit.wait(self.interval if self.runners else HOLD_CHECK_S)

        # Leaving fans wherever a stopped curve left them is how a machine cooks
        # quietly, so those go back to the firmware. A speed set by hand stays:
        # it was chosen, it is already in the hardware, and it comes back at the
        # next start anyway.
        handed = 0
        for dev_id in list(self.runners):
            dev = self.by_id.get(dev_id)
            if dev and dev_id in self.touched:
                dev["backend"].set("auto")
                handed += 1
        write_status({"time": time.time(), "fans": {}, "held": {}, "stopped": True})
        log("stopped; %d fan(s) a curve was driving went back to the firmware" % handed)
        return 0


def daemon_loop():
    return Daemon().run()


def write_status(report):
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        tmp = RUN_STATUS + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(report, fh)
        os.replace(tmp, RUN_STATUS)
        os.chmod(RUN_STATUS, 0o644)
    except OSError:
        pass


def read_run_status():
    try:
        with open(RUN_STATUS) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def log(msg):
    print("%s  %s" % (time.strftime("%H:%M:%S"), msg), flush=True)


# --------------------------------------------------------------------------
# calibration
# --------------------------------------------------------------------------
def calibrate(dev, steps=11, settle=3.0):
    """Sweep the fan and write down what it really does.

    A curve built without this is guesswork: most fans do not turn at all below
    some duty, and several stay turning well below the duty that started them.
    """
    backend = dev["backend"]
    if not backend.control:
        return {"error": "this device cannot be controlled"}
    steps = max(2, min(21, int(steps)))
    # The daemon would otherwise put the fan back after every step.
    marker = calibration_marker(dev["id"])
    try:
        os.makedirs(CALIBRATING_DIR, exist_ok=True)
        with open(marker, "w") as fh:
            fh.write(str(os.getpid()))
    except OSError:
        marker = None
    before = backend.status()
    table = []
    try:
        # down first, so the fan is stopped before we look for its start point
        backend.set("0")
        time.sleep(settle * 1.5)
        for i in range(steps):
            pct = int(round(i * 100.0 / (steps - 1)))
            ok, note = backend.set(str(pct))
            time.sleep(settle)
            st = backend.status()
            rpm = (st.get("rpms") or [None])[0]
            table.append({"percent": pct, "rpm": rpm, "ok": ok,
                          "note": note or ""})
    finally:
        # Put back what it was doing, in the same terms: a header that was in
        # full-speed mode goes back to full-speed mode, not to a manual 100%.
        was = before.get("mode")
        backend.set(was if was in ("auto", "full")
                    else str(before.get("percent", 50)))
        if marker:
            try:
                os.unlink(marker)
            except OSError:
                pass

    spinning = [row for row in table if (row["rpm"] or 0) > 0]
    result = {
        "device": dev["id"],
        "label": dev["label"],
        "table": table,
        "start_percent": spinning[0]["percent"] if spinning else None,
        "max_rpm": max((row["rpm"] or 0) for row in table) if table else 0,
        "min_rpm": min((row["rpm"] for row in spinning), default=None),
    }
    if not spinning:
        result["note"] = ("no tachometer reading at any duty: either nothing is "
                          "plugged into this header, or the fan has no sense wire")
    elif result["start_percent"] and result["start_percent"] > 0:
        result["note"] = ("this fan needs about %d%% to start; a curve that dips "
                          "below that will stall it"
                          % result["start_percent"])
    return result


# --------------------------------------------------------------------------
# saved speeds
# --------------------------------------------------------------------------
def state_raw():
    try:
        with open(STATE) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def state_load():
    """The speeds that were set, and what to do with them.

    Version 1 of this file was a bare {device id: value} map, and whether those
    came back at boot was whether a separate unit happened to be enabled.
    Version 2 carries that choice itself, and when each speed was set: with
    putting speeds back switched off, the daemon still keeps the ones set since
    it started, just not the ones from before."""
    raw = state_raw()
    out = {"version": 2, "restore_at_boot": True, "service": True,
           "speeds": {}, "set_at": {}}
    if raw is None:
        return out
    if raw.get("version") == 2:
        for key in ("restore_at_boot", "service"):
            if isinstance(raw.get(key), bool):
                out[key] = raw[key]
        speeds = raw.get("speeds") if isinstance(raw.get("speeds"), dict) else {}
        set_at = raw.get("set_at") if isinstance(raw.get("set_at"), dict) else {}
    else:
        speeds, set_at = raw, {}
    out["speeds"] = {str(k): str(v) for k, v in speeds.items()
                     if isinstance(v, (str, int))}
    out["set_at"] = {str(k): float(v) for k, v in set_at.items()
                     if isinstance(v, (int, float))}
    return out


def state_save(data):
    if os.geteuid() != 0:
        return False
    clean = {"version": 2,
             "restore_at_boot": bool(data.get("restore_at_boot", True)),
             "service": bool(data.get("service", True)),
             "speeds": dict(data.get("speeds") or {}),
             "set_at": dict(data.get("set_at") or {})}
    return write_json(STATE, clean) is None


def hwbackup_load():
    try:
        with open(HWBACKUP) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def hwbackup_save(data):
    if os.geteuid() != 0:
        return False
    return write_json(HWBACKUP, data) is None


def migrate_state(devices):
    """Version 1 keyed speeds as "cpu"/"gpu", then as "mb:<chip>". Map both onto
    the per-channel ids once, so an upgrade keeps what the user chose."""
    if os.geteuid() != 0:
        return
    state = state_load()
    saved = state["speeds"]
    if not saved:
        return
    changed = False
    for legacy in list(saved):
        # Today's ids. A graphics card's is its PCI address, which the
        # "gpu:" test below would otherwise take for a 1.x one and hand its
        # speed to every other card in the machine.
        if legacy.startswith(("hwmon:", "nvidia:")) or \
                re.match(r"gpu:[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]", legacy):
            continue
        value = saved[legacy]
        if legacy.startswith("mb:"):
            chip = legacy.split(":", 1)[1]
            targets = [d for d in devices if d["id"].startswith("hwmon:%s" % chip)]
        elif legacy == "cpu":
            targets = [d for d in devices if d["kind"] == "cpu"]
        elif legacy == "gpu" or legacy.startswith("gpu:"):
            targets = [d for d in devices if d["kind"] == "gpu"]
        else:
            continue
        for dev in targets:
            saved.setdefault(dev["id"], value)
        saved.pop(legacy, None)
        changed = True
    if changed:
        state_save(state)


