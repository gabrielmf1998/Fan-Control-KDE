CHIP_LABELS = {
    "k10temp": "CPU", "zenpower": "CPU", "coretemp": "CPU",
    "amdgpu": "GPU", "nouveau": "GPU", "i915": "GPU", "xe": "GPU",
    "nvme": "NVMe", "drivetemp": "Drive", "acpitz": "ACPI",
    "spd5118": "Memory", "iwlwifi_1": "Wi-Fi",
}

# Sensor labels that are the CPU on a Super I/O chip, in preference order.
CPU_SENSOR_HINTS = ("SMBUSMASTER 0", "TSI0_TEMP", "CPUTIN", "Tctl", "Tdie",
                    "Package id 0")

# A Super I/O chip wires more thermistor inputs than any board populates, and
# the empty ones do not read as absent - they read as 15 C, or 102 C, or 0. So
# a sensor is only trusted for "how hot is this machine" if it is either from a
# driver that knows what it is measuring, or a Super I/O input that boards
# actually connect. Everything stays selectable for a curve; this only decides
# what the icon panics about.
TRUSTED_CHIPS = ("k10temp", "zenpower", "coretemp", "amdgpu", "nouveau",
                 "i915", "xe", "nvidia", "nvme", "drivetemp")
TRUSTED_SUPERIO = ("SMBUSMASTER 0", "TSI0_TEMP", "CPUTIN", "SYSTIN",
                   "PECI Agent 0", "CPU Temperature")
PLAUSIBLE = (5.0, 120.0)


def sensor_trusted(chip, label, value):
    if not PLAUSIBLE[0] <= value <= PLAUSIBLE[1]:
        return False
    if chip in TRUSTED_CHIPS:
        return True
    return label in TRUSTED_SUPERIO


def chip_pretty(name):
    return CHIP_LABELS.get(name, name)


def hwmon_dirs():
    return sorted(glob.glob(os.path.join(SYSFS_HWMON, "hwmon*")),
                  key=lambda p: int(re.sub(r"\D", "", os.path.basename(p)) or 0))


def hwmon_name(path):
    return read_text(os.path.join(path, "name")) or os.path.basename(path)


def is_gpu_hwmon(path):
    dev = os.path.realpath(os.path.join(path, "device"))
    return os.path.isdir(os.path.join(dev, "drm"))


def discover_sensors():
    """Every readable temperature on the machine, with a stable id.

    Keyed on chip name plus sensor label rather than the hwmon number, because
    that number is assigned in probe order and moves between boots.
    """
    out = []
    seen = {}
    for path in hwmon_dirs():
        name = hwmon_name(path)
        for inp in sorted(glob.glob(os.path.join(path, "temp[0-9]*_input"))):
            value = read_int(inp)
            if value is None:
                continue
            idx = re.search(r"temp(\d+)_input", inp).group(1)
            label = read_text(inp.replace("_input", "_label")) or "temp%s" % idx
            sid = "%s:%s" % (name, label)
            if sid in seen:                       # two sensors, one label
                seen[sid] += 1
                sid = "%s#%d" % (sid, seen[sid])
            else:
                seen[sid] = 1
            crit = read_int(inp.replace("_input", "_crit"))
            temp = round(value / 1000.0, 1)
            out.append({
                "id": sid,
                "label": "%s · %s" % (chip_pretty(name), label),
                "chip": name,
                "path": inp,
                "temp": temp,
                "crit": round(crit / 1000.0, 1) if crit else None,
                "trusted": sensor_trusted(name, label, temp),
            })

    for gpu in nvidia_gpus():
        temp = gpu.get("temp")
        if temp is not None:
            out.append({
                "id": "nvidia:%d" % gpu["index"],
                "label": "GPU · %s" % gpu["name"],
                "chip": "nvidia",
                "path": None,
                "temp": float(temp),
                "crit": None,
                "trusted": True,
            })
    return out


def sensor_value(sensors, sid):
    for s in sensors:
        if s["id"] == sid:
            return s["temp"]
    return None


# --------------------------------------------------------------------------
# NVIDIA
# --------------------------------------------------------------------------
class Nvml:
    """libnvidia-ml, the library nvidia-smi is built on, through ctypes.

    Unlike nvidia-settings it needs no X display and no Coolbits: it works on a
    Wayland session, before anyone has logged in, and from a system service -
    which is exactly where a speed has to be put back after a reboot. Reading
    works as any user; setting a fan needs root. Nothing here raises: a call the
    installed driver does not have comes back as None, and the caller falls
    back to nvidia-settings.
    """

    SUCCESS = 0
    NOT_SUPPORTED = 3
    FUNCTION_NOT_FOUND = 13
    # nvmlFanControlPolicy_t
    POLICY_AUTO = 0
    POLICY_MANUAL = 1

    _lib = None
    _state = None                     # None: not tried yet

    class FanSpeedInfo(ctypes.Structure):
        _fields_ = [("version", ctypes.c_uint), ("fan", ctypes.c_uint),
                    ("speed", ctypes.c_uint)]

    class Utilization(ctypes.Structure):
        _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]

    @classmethod
    def ready(cls):
        if cls._state is None:
            cls._state = False
            try:
                lib = ctypes.CDLL("libnvidia-ml.so.1")
                if lib.nvmlInit_v2() == cls.SUCCESS:
                    cls._lib = lib
                    cls._state = True
            except (OSError, AttributeError):
                pass
        return cls._state

    @classmethod
    def rc(cls, name, *args):
        """The return code, or None when this driver has no such call."""
        if not cls.ready():
            return None
        fn = getattr(cls._lib, name, None)
        if fn is None:
            return None
        try:
            return int(fn(*args))
        except (ctypes.ArgumentError, OSError):
            return None

    @classmethod
    def error(cls, code):
        fn = getattr(cls._lib, "nvmlErrorString", None) if cls._lib else None
        if fn is None or code is None:
            return "NVML error %s" % code
        fn.restype = ctypes.c_char_p
        return (fn(code) or b"").decode(errors="replace") or "NVML error %s" % code

    @classmethod
    def handle(cls, index):
        h = ctypes.c_void_p()
        ok = cls.rc("nvmlDeviceGetHandleByIndex_v2", ctypes.c_uint(index),
                    ctypes.byref(h)) == cls.SUCCESS
        return h if ok else None

    @classmethod
    def uint(cls, name, *args):
        out = ctypes.c_uint()
        ok = cls.rc(name, *args, ctypes.byref(out)) == cls.SUCCESS
        return out.value if ok else None

    @classmethod
    def count(cls):
        return cls.uint("nvmlDeviceGetCount_v2") or 0

    @classmethod
    def name(cls, h):
        buf = ctypes.create_string_buffer(96)
        if cls.rc("nvmlDeviceGetName", h, buf, ctypes.c_uint(96)) != cls.SUCCESS:
            return ""
        return buf.value.decode(errors="replace").strip()

    @classmethod
    def fans(cls, h):
        return cls.uint("nvmlDeviceGetNumFans", h) or 0

    @classmethod
    def rpm(cls, h, fan):
        info = cls.FanSpeedInfo()
        # NVML_STRUCT_VERSION(FanSpeedInfo, 1)
        info.version = ctypes.sizeof(cls.FanSpeedInfo) | (1 << 24)
        info.fan = fan
        if cls.rc("nvmlDeviceGetFanSpeedRPM", h, ctypes.byref(info)) != cls.SUCCESS:
            return None
        return info.speed

    @classmethod
    def utilization(cls, h):
        util = cls.Utilization()
        if cls.rc("nvmlDeviceGetUtilizationRates", h, ctypes.byref(util)) != cls.SUCCESS:
            return None
        return util.gpu


_NVIDIA_CACHE = {"time": 0.0, "gpus": []}


def nvidia_gpus(max_age=2.0):
    """Every NVIDIA card, cached: discovery and the sensor list both want it.

    From NVML where the driver has it, which costs nothing; nvidia-smi is the
    fallback for a driver too old for that."""
    now = time.monotonic()
    if now - _NVIDIA_CACHE["time"] < max_age:
        return _NVIDIA_CACHE["gpus"]
    gpus = []
    for index in range(Nvml.count()):
        h = Nvml.handle(index)
        if h is None:
            continue
        gpus.append({
            "index": index,
            "name": Nvml.name(h) or "NVIDIA GPU %d" % index,
            "fan": Nvml.uint("nvmlDeviceGetFanSpeed_v2", h, ctypes.c_uint(0)),
            # NVML_TEMPERATURE_GPU
            "temp": Nvml.uint("nvmlDeviceGetTemperature", h, ctypes.c_uint(0)),
            "util": Nvml.utilization(h) or 0,
        })
    if gpus:
        _NVIDIA_CACHE.update(time=now, gpus=gpus)
        return gpus
    res = run(["nvidia-smi",
               "--query-gpu=index,name,fan.speed,temperature.gpu,utilization.gpu",
               "--format=csv,noheader,nounits"], timeout=8)
    if res and res.returncode == 0:
        for line in res.stdout.splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) < 5 or not parts[0].isdigit():
                continue
            gpus.append({
                "index": int(parts[0]),
                "name": parts[1],
                "fan": int(parts[2]) if parts[2].isdigit() else None,
                "temp": int(parts[3]) if parts[3].isdigit() else None,
                "util": int(parts[4]) if parts[4].isdigit() else 0,
            })
    _NVIDIA_CACHE.update(time=now, gpus=gpus)
    return gpus


def nvidia_env():
    env = dict(os.environ)
    env.setdefault("DISPLAY", ":0")
    # resolved fresh every call: right after boot the file may not exist yet
    xauth = sorted(glob.glob("/run/user/*/xauth_*"), key=os.path.getmtime,
                   reverse=True)
    if xauth:
        env["XAUTHORITY"] = xauth[0]
    return env


def nvidia_settings(args, timeout=15):
    try:
        return subprocess.run(["nvidia-settings"] + args, env=nvidia_env(),
                              capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


# --------------------------------------------------------------------------
# backends
# --------------------------------------------------------------------------
class Backend:
    kind = "unknown"
    control = False
    hw_curve = False
    # Seconds between checks that a held speed is still there. Reading a sysfs
    # file costs nothing; a backend that has to start a program to find out
    # asks for longer.
    check_every = HOLD_CHECK_S

    def status(self):
        return {}

    def set(self, value):
        return False, "this device cannot be controlled"

    def matches(self, value):
        """Whether the fan is still doing what `value` asked of it. True when
        there is no way to tell, so nothing gets rewritten on a guess."""
        return True

    def features(self):
        return {}


# Per-chip enable values. Probing them at runtime would mean writing to a fan
# controller to see what happens, so they are a table with a verified fallback.
HWMON_QUIRKS = {
    # nct6775 family: 0 really is "no control, full speed", and Smart Fan IV
    # (5) is the mode that reads the auto_point curve.
    "nct6775": {"manual": 1, "auto": 5, "auto_alt": 2, "full": 0, "curve": 5},
    "it87":    {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "f71882fg": {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "dell_smm": {"manual": 1, "auto": 2, "auto_alt": 0, "full": None, "curve": None},
    "thinkpad": {"manual": 1, "auto": 2, "auto_alt": None, "full": 0, "curve": None},
    "applesmc": {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "amdgpu":  {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
    "default": {"manual": 1, "auto": 2, "auto_alt": None, "full": None, "curve": None},
}

# Anything whose name starts with one of these uses that family's quirks.
QUIRK_PREFIXES = (("nct6", "nct6775"), ("w836", "nct6775"), ("it8", "it87"),
                  ("f718", "f71882fg"), ("f8", "f71882fg"),
                  ("dell", "dell_smm"), ("thinkpad", "thinkpad"))


def quirks_for(name):
    name = (name or "").lower()
    if name in HWMON_QUIRKS:
        return HWMON_QUIRKS[name]
    for prefix, key in QUIRK_PREFIXES:
        if name.startswith(prefix):
            return HWMON_QUIRKS[key]
    return HWMON_QUIRKS["default"]


class HwmonChannel(Backend):
    """One pwmN on one hwmon chip.

    Per channel rather than per chip: a board with a CPU header and five case
    headers is six independent fans, and ganging them together is exactly the
    control everybody actually wants back.
    """

    kind = "hwmon"
    control = True
    # Raw pwm units a read-back may be off by and still be what was written.
    tolerance = 2

    def __init__(self, path, channel, chip):
        self.path = path
        self.ch = channel
        self.chip = chip
        self.q = quirks_for(chip)
        # Set by discovery to the device id, so a backup can be found again.
        self.backup_key = ""

    def f(self, pattern):
        return os.path.join(self.path, pattern % self.ch)

    def bounds(self):
        lo = read_int(self.f("pwm%d_min"), 0) or 0
        hi = read_int(self.f("pwm%d_max"), 255) or 255
        if hi <= lo:
            lo, hi = 0, 255
        return lo, hi

    @property
    def has_hw_curve(self):
        return (self.q.get("curve") is not None
                and os.path.exists(self.f("pwm%d_auto_point1_pwm")))

    def temp_sources(self):
        """Which temperature the chip can pin this channel to, for its own
        hardware curve. The index is 1-based over the chip's temp inputs."""
        if not os.path.exists(self.f("pwm%d_temp_sel")):
            return []
        out = []
        for inp in sorted(glob.glob(os.path.join(self.path, "temp[0-9]*_input"))):
            idx = int(re.search(r"temp(\d+)_input", inp).group(1))
            label = read_text(inp.replace("_input", "_label")) or "temp%d" % idx
            value = read_int(inp)
            out.append({"index": idx, "label": label,
                        "temp": round(value / 1000.0, 1) if value else None})
        return out

    def mode(self):
        enable = read_int(self.f("pwm%d_enable"))
        if enable is None:
            return "unknown"
        if enable == self.q["manual"]:
            return "manual"
        if self.q["full"] is not None and enable == self.q["full"]:
            return "full"
        if self.q["curve"] is not None and enable == self.q["curve"]:
            return "hwcurve"
        return "auto"

    def status(self):
        lo, hi = self.bounds()
        raw = read_int(self.f("pwm%d"))
        mode = self.mode()
        st = {
            "raw": raw,
            "percent": 100 if mode == "full" else raw_to_pct(raw, lo, hi),
            "mode": mode,
            "rpm": read_int(self.f("fan%d_input")),
            "range": [0, 100],
            "enable": read_int(self.f("pwm%d_enable")),
        }
        st["rpms"] = [st["rpm"]] if st["rpm"] else []
        return st

    def features(self):
        return {
            "hw_curve": self.has_hw_curve,
            "temp_sel": self.temp_sources(),
            "dc_mode": read_int(self.f("pwm%d_mode")),
            "tach": os.path.exists(self.f("fan%d_input")),
        }

    def set(self, value):
        en, pw = self.f("pwm%d_enable"), self.f("pwm%d")
        if value == "auto":
            err = write_verified(en, self.q["auto"], settle=0.05)
            if err and self.q.get("auto_alt") is not None:
                err = write_verified(en, self.q["auto_alt"], settle=0.05)
            return (False, err) if err else (True, None)

        if value == "full":
            if self.q["full"] is not None:
                err = write_verified(en, self.q["full"], settle=0.05)
                if not err:
                    return True, None
            value = "100"

        try:
            pct = max(0, min(100, int(value)))
        except (TypeError, ValueError):
            return False, "not a percentage: %s" % value

        lo, hi = self.bounds()
        if pct >= 100 and self.q["full"] is not None:
            err = write_verified(en, self.q["full"], settle=0.05)
            if not err:
                return True, None
        err = write_verified(en, self.q["manual"], settle=0.05)
        if err:
            return False, err
        err = write_verified(pw, pct_to_raw(pct, lo, hi), tolerance=self.tolerance)
        return (False, err) if err else (True, None)

    def matches(self, value):
        mode = self.mode()
        if mode == "unknown":
            return False
        if value == "auto":
            return mode in ("auto", "hwcurve")
        if value == "full":
            value = "100"
        try:
            pct = max(0, min(100, int(value)))
        except (TypeError, ValueError):
            return True
        if pct >= 100 and mode == "full":
            return True
        if mode not in ("manual", "full"):
            return False
        raw = read_int(self.f("pwm%d"))
        if raw is None:
            return False
        lo, hi = self.bounds()
        return abs(raw - pct_to_raw(pct, lo, hi)) <= self.tolerance

    # ---- the chip's own curve ------------------------------------------
    def read_hw_curve(self):
        if not self.has_hw_curve:
            return None
        points = []
        for i in range(1, 6):
            t = read_int(self.f("pwm%%d_auto_point%d_temp" % i))
            v = read_int(self.f("pwm%%d_auto_point%d_pwm" % i))
            if t is None or v is None:
                break
            lo, hi = self.bounds()
            points.append([round(t / 1000.0), raw_to_pct(v, lo, hi)])
        return {"points": points,
                "temp_sel": read_int(self.f("pwm%d_temp_sel")),
                "step_up_ms": read_int(self.f("pwm%d_step_up_time")),
                "step_down_ms": read_int(self.f("pwm%d_step_down_time"))}

    def raw_hw_state(self):
        """Exactly what is in the chip's anchor registers, for backing up."""
        if not self.has_hw_curve:
            return None
        points = []
        for i in range(1, 6):
            points.append([read_int(self.f("pwm%%d_auto_point%d_temp" % i)),
                           read_int(self.f("pwm%%d_auto_point%d_pwm" % i))])
        return {"raw_points": points,
                "temp_sel": read_int(self.f("pwm%d_temp_sel")),
                "enable": read_int(self.f("pwm%d_enable"))}

    def restore_hw_state(self, saved):
        for i, pair in enumerate(saved.get("raw_points") or [], start=1):
            temp, pwm = pair
            if temp is not None:
                write_raw(self.f("pwm%%d_auto_point%d_temp" % i), temp)
            if pwm is not None:
                write_raw(self.f("pwm%%d_auto_point%d_pwm" % i), pwm)
        if saved.get("temp_sel") is not None:
            write_raw(self.f("pwm%d_temp_sel"), saved["temp_sel"])
        if saved.get("enable") is not None:
            err = write_verified(self.f("pwm%d_enable"), saved["enable"],
                                 settle=0.05)
            if err:
                return False, err
        return True, "the firmware curve this chip had before is back"

    def write_hw_curve(self, points, temp_sel=None, floor_pct=None):
        """Resample a curve to the chip's five anchor points and commit it.

        The five have to rise; the driver rejects anything else. The last one is
        pinned high so a machine that walks off the end of the curve still gets
        every fan it has.
        """
        if not self.has_hw_curve:
            return False, "this chip has no hardware curve"
        lo, hi = self.bounds()
        temps = [p[0] for p in points]
        if len(temps) < 2:
            return False, "a curve needs at least two points"

        # five evenly spaced temperatures across the curve, then the critical one
        span_lo, span_hi = min(temps), max(temps)
        anchors = []
        for i in range(4):
            t = span_lo + (span_hi - span_lo) * i / 3.0
            anchors.append((round(t), curve_value(points, t)))
        anchors.append((127, 100))

        # strictly increasing temperatures, non-decreasing pwm
        fixed = []
        last_t, last_p = -1, 0
        for t, pct in anchors:
            t = max(int(t), last_t + 1)
            pct = max(int(round(pct)), last_p)
            if floor_pct is not None:
                pct = max(pct, int(floor_pct))
            fixed.append((t, min(100, pct)))
            last_t, last_p = t, pct

        # Only the first time: a second write would back up our own curve.
        backup = hwbackup_load()
        if self.backup_key and self.backup_key not in backup:
            saved = self.raw_hw_state()
            if saved:
                backup[self.backup_key] = saved
                hwbackup_save(backup)

        if temp_sel:
            err = write_raw(self.f("pwm%d_temp_sel"), int(temp_sel))
            if err:
                return False, "temperature source: %s" % err
        for i, (t, pct) in enumerate(fixed, start=1):
            err = write_raw(self.f("pwm%%d_auto_point%d_temp" % i), t * 1000)
            if err:
                return False, "point %d temperature: %s" % (i, err)
            err = write_raw(self.f("pwm%%d_auto_point%d_pwm" % i),
                            pct_to_raw(pct, lo, hi))
            if err:
                return False, "point %d speed: %s" % (i, err)
        err = write_verified(self.f("pwm%d_enable"), self.q["curve"], settle=0.05)
        if err:
            return False, err
        return True, "the chip is running the curve now: " + \
            ", ".join("%d°C→%d%%" % (t, p) for t, p in fixed)

    def reset_hw_curve(self):
        saved = hwbackup_load().pop(self.backup_key, None) if self.backup_key \
            else None
        if saved:
            ok, note = self.restore_hw_state(saved)
            if ok:
                remaining = hwbackup_load()
                remaining.pop(self.backup_key, None)
                hwbackup_save(remaining)
            return ok, note
        # Nothing was saved, so the honest answer is that the anchor points
        # cannot be un-written; the most that is left is handing the fan back
        # to the chip's automatic mode.
        ok, err = self.set("auto")
        return ok, (err if not ok else
                    "handed back to the chip's automatic mode, but the anchor "
                    "points this curve overwrote were not saved, so that is "
                    "what it is still following")


class AmdGpu(HwmonChannel):
    """amdgpu's hwmon pwm, plus RDNA3/4's own overdrive fan curve.

    On RDNA3 the firmware refuses flat manual control on many boards - the write
    lands and the card ignores it - so the overdrive curve is not a nicety here,
    it is the only control those cards have.
    """

    kind = "amdgpu"
    # pwm1 reads back the duty the SMU is putting out, not the one written.
    tolerance = 8

    def __init__(self, path, channel, chip, od_dir=None):
        super().__init__(path, channel, chip)
        self.od = od_dir

    @property
    def has_hw_curve(self):
        return bool(self.od and os.path.exists(os.path.join(self.od, "fan_curve")))

    def od_file(self, name):
        return os.path.join(self.od, name) if self.od else None

    def read_hw_curve(self):
        if not self.has_hw_curve:
            return None
        raw = read_text(self.od_file("fan_curve")) or ""
        points, ranges = [], {}
        section = ""
        for line in raw.splitlines():
            line = line.strip()
            if line.startswith("OD_FAN_CURVE"):
                section = "curve"
                continue
            if line.startswith("OD_RANGE"):
                section = "range"
                continue
            if section == "curve":
                m = re.match(r"(\d+)\s*:\s*(\d+)C\s+(\d+)", line)
                if m:
                    points.append([int(m.group(2)), int(m.group(3))])
            elif section == "range":
                nums = re.findall(r"(\d+)", line)
                if "temp" in line.lower() and len(nums) >= 2:
                    ranges["temp"] = [int(nums[-2]), int(nums[-1])]
                elif "speed" in line.lower() and len(nums) >= 2:
                    ranges["speed"] = [int(nums[-2]), int(nums[-1])]
        out = {"points": points, "range": ranges}
        for extra in ("fan_minimum_pwm", "fan_target_temperature",
                      "fan_zero_rpm_enable", "fan_zero_rpm_stop_temperature",
                      "acoustic_limit_rpm_threshold",
                      "acoustic_target_rpm_threshold"):
            path = self.od_file(extra)
            if path and os.path.exists(path):
                out[extra] = read_text(path)
        return out

    def write_hw_curve(self, points, temp_sel=None, floor_pct=None):
        if not self.has_hw_curve:
            return False, ("this card has no overdrive fan curve; on RDNA3 and "
                           "newer it needs amdgpu.ppfeaturemask=0xffffffff on "
                           "the kernel command line")
        current = self.read_hw_curve() or {}
        slots = len(current.get("points") or []) or 5
        tlo, thi = (current.get("range", {}).get("temp") or [25, 100])
        slo, shi = (current.get("range", {}).get("speed") or [15, 100])

        temps = [p[0] for p in points]
        span_lo, span_hi = max(tlo, min(temps)), min(thi, max(temps))
        if span_hi <= span_lo:
            span_lo, span_hi = tlo, thi

        path = self.od_file("fan_curve")
        written = []
        for i in range(slots):
            t = span_lo + (span_hi - span_lo) * i / max(1, slots - 1)
            pct = curve_value(points, t)
            if floor_pct is not None:
                pct = max(pct, floor_pct)
            pct = int(max(slo, min(shi, round(pct))))
            t = int(max(tlo, min(thi, round(t))))
            err = write_raw(path, "%d %d %d" % (i, t, pct))
            if err:
                return False, "point %d: %s" % (i, err)
            written.append((t, pct))
        err = write_raw(path, "c")
        if err:
            return False, "commit: %s" % err
        return True, "the card is running the curve now: " + \
            ", ".join("%d°C→%d%%" % (t, p) for t, p in written)

    def reset_hw_curve(self):
        """amdgpu can restore its own defaults, which is better than any copy
        we could have kept: "r" then "c" puts the card's shipped curve back."""
        path = self.od_file("fan_curve")
        if path:
            err = write_raw(path, "r")
            if err:
                return False, err
            err = write_raw(path, "c")
            if err:
                return False, "commit: %s" % err
        backup = hwbackup_load()
        if self.backup_key in backup:
            backup.pop(self.backup_key, None)
            hwbackup_save(backup)
        ok, err = self.set("auto")
        return (ok, err) if not ok else (True, "the card's own fan curve is back")

    def features(self):
        f = super().features()
        f["hw_curve"] = self.has_hw_curve
        f["od_dir"] = self.od
        if self.has_hw_curve:
            f["zero_rpm"] = os.path.exists(self.od_file("fan_zero_rpm_enable"))
        return f

    def set(self, value):
        ok, err = super().set(value)
        if not ok:
            hint = ""
            if self.has_hw_curve:
                hint = ("; this card wants its overdrive fan curve instead of a "
                        "flat speed - set one in the Curves tab")
            elif os.path.exists("/sys/module/amdgpu/parameters/ppfeaturemask"):
                hint = ("; RDNA3 and newer need amdgpu.ppfeaturemask=0xffffffff "
                        "on the kernel command line for any fan control")
            return False, "%s%s" % (err, hint)
        return ok, err


class NvidiaGpu(Backend):
    """NVIDIA exposes no hwmon. NVML drives the fans where the driver has the
    calls for it (520 and newer); nvidia-settings is the fallback, and that one
    needs an X or XWayland display and Coolbits in the X configuration."""

    kind = "nvidia"
    control = True

    def __init__(self, index=0, name=""):
        self.index = index
        self.name = name
        self.h = Nvml.handle(index)
        if self.h is None:
            # Every check would start nvidia-settings twice.
            self.check_every = 15.0

    # ---- NVML ------------------------------------------------------------
    def _nvml_fans(self):
        return Nvml.fans(self.h) if self.h is not None else 0

    def _nvml_bounds(self):
        lo, hi = ctypes.c_uint(), ctypes.c_uint()
        if Nvml.rc("nvmlDeviceGetMinMaxFanSpeed", self.h, ctypes.byref(lo),
                   ctypes.byref(hi)) == Nvml.SUCCESS and hi.value > lo.value:
            return lo.value, hi.value
        return None

    def _nvml_set(self, value):
        """(ok, note), or None when NVML cannot do it and nvidia-settings
        should be tried instead."""
        fans = self._nvml_fans()
        if not fans or os.geteuid() != 0:
            return None
        if value == "auto":
            for fan in range(fans):
                code = Nvml.rc("nvmlDeviceSetDefaultFanSpeed_v2", self.h,
                               ctypes.c_uint(fan))
                if code in (None, Nvml.NOT_SUPPORTED, Nvml.FUNCTION_NOT_FOUND):
                    return None
                if code != Nvml.SUCCESS:
                    return False, Nvml.error(code)
            return True, None
        if value == "full":
            value = "100"
        try:
            want = int(value)
        except (TypeError, ValueError):
            return False, "not a percentage: %s" % value
        lo, hi = self.bounds()
        pct = max(lo, min(hi, want))
        for fan in range(fans):
            code = Nvml.rc("nvmlDeviceSetFanSpeed_v2", self.h, ctypes.c_uint(fan),
                           ctypes.c_uint(pct))
            if code in (None, Nvml.NOT_SUPPORTED, Nvml.FUNCTION_NOT_FOUND):
                return None
            if code != Nvml.SUCCESS:
                return False, Nvml.error(code)
        got = Nvml.uint("nvmlDeviceGetTargetFanSpeed", self.h, ctypes.c_uint(0))
        if got is not None and abs(got - pct) > 1:
            return False, "the driver kept %d%% (asked for %d%%)" % (got, pct)
        if pct != want:
            return True, "clamped to %d%%: this GPU accepts %d-%d%%" % (pct, lo, hi)
        return True, None

    # ---- nvidia-settings --------------------------------------------------
    def _q(self, attr):
        return nvidia_settings(["-q", attr])

    def _xs_bounds(self):
        """GeForce cards refuse anything under about 30%, and nvidia-settings
        exits 0 even when it refuses."""
        r = self._q("[fan:0]/GPUTargetFanSpeed")
        if r and r.returncode == 0:
            m = re.search(r"range\s+(\d+)\s*-\s*(\d+)", r.stdout)
            if m:
                return int(m.group(1)), int(m.group(2))
        return 30, 100

    def target(self):
        r = self._q("[fan:0]/GPUTargetFanSpeed")
        if r and r.returncode == 0:
            m = re.search(r"GPUTargetFanSpeed'\s*\([^)]*\):\s*(\d+)", r.stdout)
            if m:
                return int(m.group(1))
        return None

    def fan_count(self):
        if self.h is not None:
            return max(1, self._nvml_fans())
        r = self._q("[gpu:%d]/GPUFanCount" % self.index)
        if r and r.returncode == 0:
            m = re.search(r":\s*(\d+)", r.stdout)
            if m:
                return max(1, min(8, int(m.group(1))))
        return 2

    def rpms(self):
        out = []
        if self.h is not None:
            for fan in range(self._nvml_fans()):
                rpm = Nvml.rpm(self.h, fan)
                if rpm:
                    out.append(rpm)
            return out
        for fan in range(self.fan_count()):
            q = self._q("[fan:%d]/GPUCurrentFanSpeedRPM" % fan)
            if not q or q.returncode != 0:
                continue
            for line in q.stdout.splitlines():
                if "GPUCurrentFanSpeedRPM" in line and "):" in line:
                    digits = line.rsplit("):", 1)[1].strip().rstrip(".")
                    if digits.isdigit():
                        out.append(int(digits))
                    break
        return out

    # ---- the backend -------------------------------------------------------
    def bounds(self):
        if self.h is not None:
            nvml = self._nvml_bounds()
            if nvml:
                return nvml
        return self._xs_bounds()

    def status(self):
        if self.h is not None and self._nvml_fans():
            fans = range(self._nvml_fans())
            policies = [Nvml.uint("nvmlDeviceGetFanControlPolicy_v2", self.h,
                                  ctypes.c_uint(f)) for f in fans]
            target = Nvml.uint("nvmlDeviceGetTargetFanSpeed", self.h, ctypes.c_uint(0))
            if target is None:
                target = Nvml.uint("nvmlDeviceGetFanSpeed_v2", self.h, ctypes.c_uint(0))
            return {
                "rpms": self.rpms(),
                "percent": target or 0,
                "temp": Nvml.uint("nvmlDeviceGetTemperature", self.h, ctypes.c_uint(0)),
                "util": Nvml.utilization(self.h),
                "mode": ("manual" if Nvml.POLICY_MANUAL in policies else "auto"),
                "range": list(self.bounds()),
                "reason": "",
            }
        gpu = next((g for g in nvidia_gpus() if g["index"] == self.index), None)
        if gpu is None:
            return {"rpms": [], "percent": 0, "mode": "auto", "range": [30, 100],
                    "reason": "nvidia-smi is not answering"}
        r = self._q("[gpu:%d]/GPUFanControlState" % self.index)
        manual = bool(r and ": 1." in r.stdout)
        if r is None or r.returncode != 0:
            reason = ("nvidia-settings cannot reach a display; fan control needs "
                      "an X or XWayland session with Coolbits enabled")
        else:
            reason = ""
        return {
            "rpms": self.rpms(),
            "percent": gpu.get("fan") or 0,
            "temp": gpu.get("temp"),
            "util": gpu.get("util"),
            "mode": "manual" if manual else "auto",
            "range": list(self.bounds()),
            "reason": reason,
        }

    def features(self):
        return {"hw_curve": False, "fans": self.fan_count(),
                "needs_display": self.h is None, "nvml": self.h is not None}

    def matches(self, value):
        if value == "full":
            value = "100"
        if self.h is not None and self._nvml_fans():
            fans = range(self._nvml_fans())
            policies = [Nvml.uint("nvmlDeviceGetFanControlPolicy_v2", self.h,
                                  ctypes.c_uint(f)) for f in fans]
            if None in policies:
                return True
            if value == "auto":
                return all(p == Nvml.POLICY_AUTO for p in policies)
            try:
                lo, hi = self.bounds()
                pct = max(lo, min(hi, int(value)))
            except (TypeError, ValueError):
                return True
            if any(p != Nvml.POLICY_MANUAL for p in policies):
                return False
            for fan in fans:
                got = Nvml.uint("nvmlDeviceGetTargetFanSpeed", self.h, ctypes.c_uint(fan))
                if got is not None and abs(got - pct) > 1:
                    return False
            return True
        r = self._q("[gpu:%d]/GPUFanControlState" % self.index)
        if r is None or r.returncode != 0:
            return True                   # no display yet: cannot tell
        manual = ": 1." in r.stdout
        if value == "auto":
            return not manual
        if not manual:
            return False
        got = self.target()
        try:
            lo, hi = self._xs_bounds()
            return got is None or abs(got - max(lo, min(hi, int(value)))) <= 1
        except (TypeError, ValueError):
            return True

    def set(self, value):
        if self.h is not None:
            done = self._nvml_set(value)
            if done is not None:
                return done
        if value == "auto":
            r = nvidia_settings(["-a", "[gpu:%d]/GPUFanControlState=0" % self.index])
            ok = r is not None and r.returncode == 0
            return ok, (None if ok else "nvidia-settings could not reach a display")

        if value == "full":
            value = "100"
        try:
            want = int(value)
        except (TypeError, ValueError):
            return False, "not a percentage: %s" % value

        lo, hi = self._xs_bounds()
        pct = max(lo, min(hi, want))
        r = nvidia_settings(["-a", "[gpu:%d]/GPUFanControlState=1" % self.index])
        if r is None or r.returncode != 0:
            return False, ("could not enable manual fan control - Coolbits is "
                           "probably not set in the X configuration")
        for fan in range(self.fan_count()):
            nvidia_settings(["-a", "[fan:%d]/GPUTargetFanSpeed=%d" % (fan, pct)])

        got = self.target()          # exit codes from nvidia-settings mean nothing
        if got is None:
            return False, "could not read the fan speed back"
        if got != pct:
            return False, "the driver kept %d%% (asked for %d%%)" % (got, pct)
        if pct != want:
            return True, "clamped to %d%%: this GPU accepts %d-%d%%" % (pct, lo, hi)
        return True, None


class MonitorOnly(Backend):
    """Reports speed but cannot set it - Intel's discrete cards, mostly: the
    fan-speed PWM patches for xe are still out of tree."""

    kind = "monitor"
    control = False

    def __init__(self, path, reason):
        self.path = path
        self.reason = reason

    def status(self):
        rpms = []
        for f in sorted(glob.glob(os.path.join(self.path, "fan[0-9]*_input"))):
            v = read_int(f)
            if v is not None:
                rpms.append(v)
        return {"rpms": rpms, "percent": 0, "mode": "auto",
                "range": [0, 100], "reason": self.reason}


