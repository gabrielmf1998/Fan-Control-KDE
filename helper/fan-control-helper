# systemd
# --------------------------------------------------------------------------
def daemon_units():
    """(LoadState, UnitFileState, ActiveState) of the service, in one call -
    this runs on every poll. Empty strings when there is no systemctl."""
    r = run(["systemctl", "show", DAEMON_UNIT, "-p", "LoadState",
             "-p", "UnitFileState", "-p", "ActiveState"], timeout=6)
    if r is None or r.returncode != 0:
        return "", "", ""
    vals = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
    return (vals.get("LoadState", ""), vals.get("UnitFileState", ""),
            vals.get("ActiveState", ""))


def unit_set(unit, on):
    r = run(["systemctl", "enable" if on else "disable", "--now", unit], timeout=30)
    if r is None:
        return 1, "systemctl did not answer"
    return r.returncode, (r.stderr or "").strip()


def ensure_daemon():
    """Start the service if it should be running and is not.

    Everything that saves a speed or a curve calls this, so an install whose
    package scripts never ran - a manual copy, a distribution that skips them -
    still ends up with something keeping what was set. A service switched off
    from the settings window stays off."""
    if os.geteuid() != 0 or not state_load().get("service", True):
        return
    load, filestate, active = daemon_units()
    if load != "loaded":
        return
    if active in ("active", "activating", "reloading") and \
            filestate in ("enabled", "enabled-runtime", "static", "linked", "alias"):
        return
    code, err = unit_set(DAEMON_UNIT, True)
    if code != 0 and err:
        print("could not start %s: %s" % (DAEMON_UNIT, err), file=sys.stderr)


