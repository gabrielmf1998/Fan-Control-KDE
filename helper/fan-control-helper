def cmd_status():
    sensors = discover_sensors()
    devices = discover()
    migrate_state(devices)
    store = curves_load()
    state = state_load()
    load, filestate, active = daemon_units()
    if load == "not-found":
        daemon = boot = "not-found"
    elif load:
        daemon = filestate
        boot = "enabled" if state["restore_at_boot"] else "disabled"
    else:
        daemon = boot = ""
    print(json.dumps({
        "version": VERSION,
        "devices": [device_status(d, sensors) for d in devices],
        "sensors": [{k: v for k, v in s.items() if k != "path"} for s in sensors],
        "curves": store,
        "runtime": read_run_status(),
        "saved": state["speeds"],
        "restore_at_boot": state["restore_at_boot"],
        "units": {
            "daemon": daemon,
            "daemon_active": active,
            # What a 2.3 tray reads, still running after an upgrade until it
            # is restarted: "boot" is whether speeds come back at start, and
            # "curve" is the one service that now does both.
            "boot": boot,
            "curve": daemon,
            "curve_active": active,
        },
    }))
    return 0


def cmd_sensors():
    print(json.dumps({"sensors": [{k: v for k, v in s.items() if k != "path"}
                                  for s in discover_sensors()]}))
    return 0


def cmd_set(dev_id, value):
    devices = discover()
    dev = next((d for d in devices if d["id"] == dev_id), None)
    if not dev:
        print("no such device: %s" % dev_id, file=sys.stderr)
        return 2

    ok, note = dev["backend"].set(value)
    if not ok:
        print(note or "failed", file=sys.stderr)
        return 1

    # Saved before the curve is switched off, so that when the daemon sees the
    # curve go it already finds this speed to keep, not the one before it.
    state = state_load()
    state["speeds"][dev_id] = value
    state["set_at"][dev_id] = time.time()
    saved = state_save(state)

    # A hand-set speed and a running curve are the same knob, and the curve
    # would simply undo this a second later. The last thing asked for wins.
    store = curves_load()
    curve = (store.get("curves") or {}).get(dev_id)
    note_curve = ""
    if isinstance(curve, dict) and curve.get("enabled"):
        curve["enabled"] = False
        curves_save(store)
        note_curve = " (its fan curve was switched off)"
    ensure_daemon()
    if not saved:
        note_curve += " - but it could not be saved, so a reboot will lose it"
    if note or note_curve:
        print((note or "") + note_curve)
    return 0


def cmd_curve(args):
    if not args or args[0] == "show":
        print(json.dumps(curves_load()))
        return 0
    if args[0] == "set":
        try:
            data = json.load(sys.stdin)
        except ValueError as exc:
            print("unreadable JSON on stdin: %s" % exc, file=sys.stderr)
            return 2
        if not isinstance(data, dict):
            print("the curves have to be a JSON object", file=sys.stderr)
            return 2
        ok, err = curves_save(data)
        if not ok:
            print(err, file=sys.stderr)
            return 1
        # a running daemon notices the file changing on its own
        ensure_daemon()
        return 0
    if args[0] == "enable" and len(args) == 3:
        store = curves_load()
        entry = store.setdefault("curves", {}).setdefault(args[1],
                                                          dict(CURVE_DEFAULTS))
        entry["enabled"] = args[2] in ("on", "true", "1", "yes")
        ok, err = curves_save(store)
        if not ok:
            print(err, file=sys.stderr)
            return 1
        ensure_daemon()
        return 0
    print("curve takes show, set or enable <id> <on|off>", file=sys.stderr)
    return 2


def cmd_hwcurve(args):
    if not args:
        print("hwcurve takes a device id", file=sys.stderr)
        return 2
    dev_id = args[0]
    dev = next((d for d in discover() if d["id"] == dev_id), None)
    if not dev:
        print("no such device: %s" % dev_id, file=sys.stderr)
        return 2
    backend = dev["backend"]
    if not getattr(backend, "has_hw_curve", False):
        print("this device has no firmware fan curve", file=sys.stderr)
        return 1
    if len(args) > 1 and args[1] == "reset":
        ok, note = backend.reset_hw_curve()
        print(note or ("back to the firmware's own curve" if ok else "failed"),
              file=sys.stdout if ok else sys.stderr)
        return 0 if ok else 1

    store = curves_load()
    curve = curve_for(store, dev_id)
    temp_sel = None
    if isinstance(backend, HwmonChannel) and not isinstance(backend, AmdGpu):
        wanted = curve.get("source") or ""
        for src in backend.temp_sources():
            if wanted.endswith(":" + src["label"]):
                temp_sel = src["index"]
                break
    ok, note = backend.write_hw_curve(curve["points"], temp_sel,
                                      curve.get("min_percent"))
    print(note or ("done" if ok else "failed"),
          file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_calibrate(args):
    if os.geteuid() != 0:
        print("calibration needs root", file=sys.stderr)
        return 2
    if not args:
        print("calibrate takes a device id", file=sys.stderr)
        return 2
    dev = next((d for d in discover() if d["id"] == args[0]), None)
    if not dev:
        print("no such device: %s" % args[0], file=sys.stderr)
        return 2
    steps = int(args[1]) if len(args) > 1 and args[1].isdigit() else 11
    print(json.dumps(calibrate(dev, steps=steps)))
    return 0


def cmd_restore():
    """Put every saved speed back now - the daemon does this when it starts;
    this is for doing it by hand."""
    if os.geteuid() != 0:
        print("needs root", file=sys.stderr)
        return 2
    devices = discover()
    by_id = {d["id"]: d for d in devices}
    migrate_state(devices)
    state = state_load()
    curves = (curves_load().get("curves") or {})
    failed = 0
    for dev_id, value in state["speeds"].items():
        dev = by_id.get(dev_id)
        if not dev or (curves.get(dev_id) or {}).get("enabled"):
            continue
        ok, note = dev["backend"].set(value)
        print("%s -> %s%s" % (dev_id, value, "" if ok else "  FAILED: %s" % note))
        failed += 0 if ok else 1
    return 1 if failed else 0


def cmd_daemon(arg):
    if arg == "status":
        _load, filestate, active = daemon_units()
        print("%s %s" % (filestate or "unknown", active or "unknown"))
        return 0
    if arg not in ("on", "off"):
        print("daemon takes on, off or status", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("needs root", file=sys.stderr)
        return 2
    state = state_load()
    state["service"] = arg == "on"
    state_save(state)
    code, err = unit_set(DAEMON_UNIT, arg == "on")
    if code != 0 and err:
        print(err, file=sys.stderr)
    return code


def cmd_boot(arg):
    state = state_load()
    if arg == "status":
        _load, _filestate, active = daemon_units()
        print("%s %s" % ("enabled" if state["restore_at_boot"] else "disabled",
                         active or "unknown"))
        return 0
    if arg not in ("on", "off"):
        print("boot takes on, off or status", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("needs root", file=sys.stderr)
        return 2
    state["restore_at_boot"] = arg == "on"
    if not state_save(state):
        print("could not write %s" % STATE, file=sys.stderr)
        return 1
    if arg == "on":
        ensure_daemon()
    return 0


def cmd_migrate():
    """What the packages run after installing or upgrading.

    Up to 2.3 there were two units: a restore at boot that had to be switched
    on by hand, and a curve loop. Their choices move into state.json and the
    one service takes over from both. Safe to run any number of times."""
    if os.geteuid() != 0:
        print("migrate needs root", file=sys.stderr)
        return 2
    links = {unit: glob.glob(os.path.join(SYSTEMD_ETC, "*.wants", unit))
             for unit in OLD_UNITS}
    raw = state_raw()
    state = state_load()
    if raw is not None and raw.get("version") != 2:
        # A 2.3 file: speeds only came back at boot if the restore unit was on.
        state["restore_at_boot"] = bool(links["fan-control-kde-restore.service"]
                                        or links["fan-tray-restore.service"])
    if raw is None or raw.get("version") != 2:
        state_save(state)

    for unit in OLD_UNITS:
        run(["systemctl", "stop", unit], timeout=30)
    removed = 0
    for paths in links.values():
        for path in paths:
            try:
                os.unlink(path)
                removed += 1
            except OSError:
                pass
    run(["systemctl", "daemon-reload"], timeout=30)

    if state["service"]:
        run(["systemctl", "enable", DAEMON_UNIT], timeout=30)
        # restart rather than start: after an upgrade the one running is the
        # old code
        run(["systemctl", "restart", DAEMON_UNIT], timeout=30)
    print("fan-control-kde: %s; saved speeds %s put back at start%s" % (
        "service enabled" if state["service"] else "service left off",
        "are" if state["restore_at_boot"] else "are not",
        "; %d old unit link(s) removed" % removed if removed else ""))
    return 0


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    cmd, args = sys.argv[1], sys.argv[2:]

    if cmd == "version":
        print(VERSION)
        return 0
    if cmd == "status":
        return cmd_status()
    if cmd == "sensors":
        return cmd_sensors()
    if cmd == "set" and len(args) == 2:
        return cmd_set(args[0], args[1])
    if cmd == "curve":
        return cmd_curve(args)
    if cmd == "hwcurve":
        return cmd_hwcurve(args)
    if cmd == "calibrate":
        return cmd_calibrate(args)
    if cmd == "restore":
        return cmd_restore()
    if cmd == "migrate":
        return cmd_migrate()
    if cmd == "daemon":
        if not args:
            return daemon_loop()
        return cmd_daemon(args[0])
    if cmd == "boot" and len(args) == 1:
        return cmd_boot(args[0])

    print("unknown command: %s" % cmd, file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
