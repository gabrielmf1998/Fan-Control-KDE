# discovery
# --------------------------------------------------------------------------
def pci_name(slot):
    """A readable name for a PCI device, e.g. 'AMD Radeon RX 9070 XT'."""
    out = run(["lspci", "-mm", "-s", slot], timeout=5)
    if not out or out.returncode != 0:
        return None
    fields = re.findall(r'"([^"]*)"', out.stdout)
    if len(fields) < 3:
        return None
    vendor, device = fields[1], fields[2]
    vendor = vendor.split()[0].strip(",")
    inner = re.search(r"\[([^\]]+)\]\s*$", device)
    if inner:
        device = inner.group(1)
    for noise in ("Lite Hash Rate", "LHR", "OEM"):
        device = device.replace(noise, "")
    device = re.sub(r"\s*\(rev [^)]*\)", "", device)
    device = re.sub(r"\s{2,}", " ", device).strip(" /-")
    if vendor.lower().startswith(("advanced", "ati")):
        vendor = "AMD"
    return ("%s %s" % (vendor, device)).strip()


def header_label(channel):
    """A guess at what a motherboard header is for, which the user can rename.

    Channel 1 is the CPU header on every Super I/O layout worth naming, and the
    rest are chassis headers in order.
    """
    return "CPU fan" if channel == 1 else "Fan header %d" % channel


def gpu_od_dir(dev_path):
    d = os.path.join(dev_path, "gpu_od", "fan_ctrl")
    return d if os.path.isdir(d) else None


def hwmon_of(device_path):
    for h in sorted(glob.glob(os.path.join(device_path, "hwmon", "hwmon*"))):
        return h
    return None


def discover():
    devices = []
    used_names = {}

    # ---- motherboard and anything else with pwm that is not a GPU --------
    for path in hwmon_dirs():
        if is_gpu_hwmon(path):
            continue
        channels = sorted(int(re.search(r"pwm(\d+)$", p).group(1))
                          for p in glob.glob(os.path.join(path, "pwm[0-9]*"))
                          if re.search(r"pwm\d+$", p))
        if not channels:
            continue
        name = hwmon_name(path)
        used_names[name] = used_names.get(name, 0) + 1
        suffix = "" if used_names[name] == 1 else "#%d" % used_names[name]
        for ch in channels:
            backend = HwmonChannel(path, ch, name)
            backend.backup_key = "hwmon:%s%s:pwm%d" % (name, suffix, ch)
            devices.append({
                "id": "hwmon:%s%s:pwm%d" % (name, suffix, ch),
                "label": header_label(ch),
                "detail": "%s · pwm%d" % (name, ch),
                "kind": "cpu" if ch == 1 else "case",
                "backend": backend,
                "temp_hint": pick_cpu_sensor,
            })

    # ---- GPUs -----------------------------------------------------------
    for card in sorted(glob.glob(os.path.join(SYSFS_DRM, "card[0-9]*"))):
        if "-" in os.path.basename(card):            # card1-DP-1 and friends
            continue
        dev = os.path.realpath(os.path.join(card, "device"))
        if not os.path.isdir(dev):
            continue
        driver = os.path.basename(os.path.realpath(os.path.join(dev, "driver")))
        slot = os.path.basename(dev)
        label = pci_name(slot.replace("0000:", "")) or driver

        if driver == "nvidia":
            continue                                  # handled from nvidia-smi

        hw = hwmon_of(dev)
        if not hw:
            continue
        channels = sorted(int(re.search(r"pwm(\d+)$", p).group(1))
                          for p in glob.glob(os.path.join(hw, "pwm[0-9]*"))
                          if re.search(r"pwm\d+$", p))
        has_tach = bool(glob.glob(os.path.join(hw, "fan[0-9]*_input")))
        od = gpu_od_dir(dev)

        if channels:
            chip = hwmon_name(hw)
            for ch in channels:
                backend = (AmdGpu(hw, ch, chip, od) if driver == "amdgpu"
                           else HwmonChannel(hw, ch, chip))
                backend.backup_key = ("gpu:%s:pwm%d" % (slot, ch)
                                      if len(channels) > 1 else "gpu:%s" % slot)
                devices.append({
                    "id": "gpu:%s:pwm%d" % (slot, ch) if len(channels) > 1
                          else "gpu:%s" % slot,
                    "label": label,
                    "detail": "%s · %s" % (driver, slot),
                    "kind": "gpu",
                    "backend": backend,
                    "temp_hint": lambda s, p=hw: hwmon_pick(s, p),
                })
        elif has_tach:
            reason = ("the %s driver reports fan speed but exposes no PWM "
                      "control; the patches for that are not in mainline yet"
                      % driver)
            devices.append({
                "id": "gpu:%s" % slot, "label": label,
                "detail": "%s · %s" % (driver, slot), "kind": "gpu",
                "backend": MonitorOnly(hw, reason), "temp_hint": None,
            })
        elif od:
            # A card with an overdrive curve but no pwm channel: RDNA3 boards
            # whose firmware exposes the curve and nothing else.
            backend = AmdGpu(hw, 1, hwmon_name(hw), od)
            backend.backup_key = "gpu:%s" % slot
            devices.append({
                "id": "gpu:%s" % slot, "label": label,
                "detail": "%s · %s" % (driver, slot), "kind": "gpu",
                "backend": backend,
                "temp_hint": lambda s, p=hw: hwmon_pick(s, p),
            })

    for gpu in nvidia_gpus():
        devices.append({
            "id": "nvidia:%d" % gpu["index"],
            "label": gpu["name"],
            "detail": "nvidia-settings",
            "kind": "gpu",
            "backend": NvidiaGpu(gpu["index"], gpu["name"]),
            "temp_hint": lambda s, i=gpu["index"]: "nvidia:%d" % i,
        })

    return devices


def pick_cpu_sensor(sensors):
    """The sensor a CPU-header curve should follow, if nobody chose one."""
    for hint in CPU_SENSOR_HINTS:
        for s in sensors:
            if s["id"].endswith(":" + hint):
                return s["id"]
    for s in sensors:
        if s["chip"] in ("k10temp", "zenpower", "coretemp"):
            return s["id"]
    return sensors[0]["id"] if sensors else None


def hwmon_pick(sensors, path):
    """The hottest-named sensor belonging to one hwmon directory."""
    prefer = ("junction", "hotspot", "edge", "mem")
    name = hwmon_name(path)
    mine = [s for s in sensors if s["chip"] == name]
    for key in prefer:
        for s in mine:
            if s["id"].lower().endswith(":" + key):
                return s["id"]
    return mine[0]["id"] if mine else None


def device_status(dev, sensors):
    st = dict(dev["backend"].status())
    st.update({
        "id": dev["id"], "label": dev["label"], "detail": dev["detail"],
        "kind": dev["kind"], "control": dev["backend"].control,
        "backend": dev["backend"].kind,
        "features": dev["backend"].features(),
    })
    st.setdefault("rpms", [])
    if st.get("temp") is None and dev.get("temp_hint"):
        try:
            sid = dev["temp_hint"](sensors)
        except TypeError:
            sid = None
        if sid:
            st["temp"] = sensor_value(sensors, sid)
            st["temp_source"] = sid
    hw = getattr(dev["backend"], "read_hw_curve", lambda: None)()
    if hw:
        st["hw_curve"] = hw
    return st


# --------------------------------------------------------------------------
# curves
# --------------------------------------------------------------------------
CURVE_DEFAULTS = {
    "enabled": False,
    "source": "",            # sensor id; empty means the device's own sensor
    "points": [[30, 25], [50, 40], [65, 65], [80, 100]],
    "hysteresis": 3.0,       # °C the temperature has to fall before we ease off
    "min_percent": 0,
    "max_percent": 100,
    "spinup_percent": 45,    # kick to get a stopped fan turning
    "spinup_ms": 900,
    "zero_below": 0,         # stop the fan below this temperature; 0 disables
    "ramp_up": 40,           # percentage points per second, going up
    "ramp_down": 8,          # and coming down, deliberately slower
}


def curve_value(points, temp):
    """Linear interpolation between the points, flat outside them."""
    pts = sorted((float(t), float(v)) for t, v in points)
    if not pts:
        return 0.0
    if temp <= pts[0][0]:
        return pts[0][1]
    if temp >= pts[-1][0]:
        return pts[-1][1]
    for (t0, v0), (t1, v1) in zip(pts, pts[1:]):
        if t0 <= temp <= t1:
            if t1 == t0:
                return v1
            return v0 + (v1 - v0) * (temp - t0) / (t1 - t0)
    return pts[-1][1]


def curves_load():
    try:
        with open(CURVES) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {"version": 1, "interval_ms": 1000, "curves": {}}
    if not isinstance(data, dict):
        return {"version": 1, "interval_ms": 1000, "curves": {}}
    data.setdefault("version", 1)
    data.setdefault("interval_ms", 1000)
    data.setdefault("curves", {})
    return data


def curve_for(store, dev_id):
    c = dict(CURVE_DEFAULTS)
    c.update(store.get("curves", {}).get(dev_id) or {})
    return c


def curves_save(data):
    if os.geteuid() != 0:
        return False, "needs root"
    clean = {"version": 1,
             "interval_ms": int(max(200, min(10000, data.get("interval_ms", 1000)))),
             "curves": {}}
    for dev_id, raw in (data.get("curves") or {}).items():
        if not isinstance(raw, dict):
            continue
        c = dict(CURVE_DEFAULTS)
        for key in CURVE_DEFAULTS:
            if key in raw:
                c[key] = raw[key]
        points = []
        for pair in c["points"]:
            try:
                t, v = float(pair[0]), float(pair[1])
            except (TypeError, ValueError, IndexError):
                continue
            points.append([max(0.0, min(120.0, t)), max(0.0, min(100.0, v))])
        if len(points) < 2:
            return False, "%s: a curve needs at least two points" % dev_id
        c["points"] = sorted(points)
        c["enabled"] = bool(c["enabled"])
        c["min_percent"] = int(max(0, min(100, c["min_percent"])))
        c["max_percent"] = int(max(c["min_percent"], min(100, c["max_percent"])))
        c["hysteresis"] = float(max(0.0, min(20.0, c["hysteresis"])))
        c["spinup_percent"] = int(max(0, min(100, c["spinup_percent"])))
        c["spinup_ms"] = int(max(0, min(5000, c["spinup_ms"])))
        c["zero_below"] = int(max(0, min(90, c["zero_below"])))
        c["ramp_up"] = float(max(1.0, min(100.0, c["ramp_up"])))
        c["ramp_down"] = float(max(1.0, min(100.0, c["ramp_down"])))
        clean["curves"][dev_id] = c
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = CURVES + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(clean, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, CURVES)
    except OSError as exc:
        return False, exc.strerror or str(exc)
    return True, None


# --------------------------------------------------------------------------
# the curve daemon
# --------------------------------------------------------------------------
class CurveRunner:
    """One fan under one curve: hysteresis, ramping, spin-up and a floor."""

    def __init__(self, dev, curve, source):
        self.dev = dev
        self.curve = curve
        self.source = source
        self.applied_temp = None
        self.applied_pct = None
        self.spinup_until = 0.0
        self.last = {}

    def target(self, temp, now):
        c = self.curve
        # hysteresis: rise at once, fall only after the temperature really has
        if self.applied_temp is None or temp > self.applied_temp:
            self.applied_temp = temp
        elif temp < self.applied_temp - c["hysteresis"]:
            self.applied_temp = temp
        eff = self.applied_temp

        if c["zero_below"] and eff < c["zero_below"]:
            want = 0.0
        else:
            want = curve_value(c["points"], eff)
            want = max(c["min_percent"], min(c["max_percent"], want))

        if temp >= EMERGENCY_TEMP:
            return 100.0, "emergency"

        # a fan that is stopped needs a shove before it will take a low duty
        if want > 0 and (self.applied_pct or 0) <= 0 and c["spinup_percent"] > 0:
            if now >= self.spinup_until:
                self.spinup_until = now + c["spinup_ms"] / 1000.0
            return max(want, c["spinup_percent"]), "spin-up"
        if now < self.spinup_until:
            return max(want, c["spinup_percent"]), "spin-up"

        # ramp: limit how far it may move in one interval
        if self.applied_pct is not None:
            limit = c["ramp_up"] if want > self.applied_pct else c["ramp_down"]
            step = limit * self.interval
            want = max(self.applied_pct - step, min(self.applied_pct + step, want))
        return want, "curve"

    interval = 1.0


def daemon_loop():
    if os.geteuid() != 0:
        print("the curve daemon needs root", file=sys.stderr)
        return 1

    stop = {"now": False}

    def _stop(_sig, _frame):
        stop["now"] = True

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        os.chmod(RUN_DIR, 0o755)
    except OSError:
        pass

    store = curves_load()
    interval = max(0.2, store.get("interval_ms", 1000) / 1000.0)
    devices = discover()
    by_id = {d["id"]: d for d in devices}
    runners = {}
    mtime = os.path.getmtime(CURVES) if os.path.exists(CURVES) else 0
    touched = []

    def rebuild():
        # Re-discovered as well as re-read: a GPU driver that loaded after this
        # started would otherwise never be seen without restarting the service.
        nonlocal store, interval, runners, devices, by_id
        devices = discover()
        by_id = {d["id"]: d for d in devices}
        store = curves_load()
        interval = max(0.2, store.get("interval_ms", 1000) / 1000.0)
        sensors = discover_sensors()
        runners = {}
        for dev_id, raw in (store.get("curves") or {}).items():
            curve = dict(CURVE_DEFAULTS)
            curve.update(raw)
            if not curve["enabled"]:
                continue
            dev = by_id.get(dev_id)
            if not dev or not dev["backend"].control:
                continue
            source = curve["source"]
            if not source and dev.get("temp_hint"):
                try:
                    source = dev["temp_hint"](sensors)
                except TypeError:
                    source = None
            if not source:
                continue
            runner = CurveRunner(dev, curve, source)
            runner.interval = interval
            runners[dev_id] = runner

    rebuild()
    log("curve daemon started, %d curve(s) active" % len(runners))

    while not stop["now"]:
        try:
            now = os.path.getmtime(CURVES) if os.path.exists(CURVES) else 0
            if now != mtime:
                mtime = now
                rebuild()
                log("curves reloaded, %d active" % len(runners))

            sensors = discover_sensors()
            report = {"time": time.time(), "fans": {}}
            for dev_id, runner in runners.items():
                temp = sensor_value(sensors, runner.source)
                if temp is None:
                    pct, why = FALLBACK_PERCENT, "no sensor"
                else:
                    pct, why = runner.target(temp, time.monotonic())
                pct = int(round(pct))
                if runner.applied_pct is None or pct != int(runner.applied_pct):
                    ok, note = runner.dev["backend"].set(str(pct))
                    if ok:
                        runner.applied_pct = pct
                        if dev_id not in touched:
                            touched.append(dev_id)
                    else:
                        why = "failed: %s" % note
                report["fans"][dev_id] = {
                    "percent": runner.applied_pct, "temp": temp,
                    "source": runner.source, "why": why,
                    "label": runner.dev["label"],
                }
            write_status(report)
        except Exception as exc:                    # a loop that dies is worse
            log("daemon error: %r" % exc)
        time.sleep(interval)

    # Leaving fans wherever a stopped daemon left them is how a machine cooks
    # quietly. Hand every fan we touched back to its firmware on the way out.
    for dev_id in touched:
        dev = by_id.get(dev_id)
        if dev:
            dev["backend"].set("auto")
    write_status({"time": time.time(), "fans": {}, "stopped": True})
    log("curve daemon stopped, %d fan(s) returned to firmware control" % len(touched))
    return 0


def write_status(report):
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        tmp = RUN_STATUS + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(report, fh)
        os.replace(tmp, RUN_STATUS)
        os.chmod(RUN_STATUS, 0o644)
    except OSError:
        pass


def read_run_status():
    try:
        with open(RUN_STATUS) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def log(msg):
    print("%s  %s" % (time.strftime("%H:%M:%S"), msg), flush=True)


# --------------------------------------------------------------------------
# calibration
# --------------------------------------------------------------------------
def calibrate(dev, steps=11, settle=3.0):
    """Sweep the fan and write down what it really does.

    A curve built without this is guesswork: most fans do not turn at all below
    some duty, and several stay turning well below the duty that started them.
    """
    backend = dev["backend"]
    if not backend.control:
        return {"error": "this device cannot be controlled"}
    before = backend.status()
    table = []
    try:
        # down first, so the fan is stopped before we look for its start point
        backend.set("0")
        time.sleep(settle * 1.5)
        for i in range(steps):
            pct = int(round(i * 100.0 / (steps - 1)))
            ok, note = backend.set(str(pct))
            time.sleep(settle)
            st = backend.status()
            rpm = (st.get("rpms") or [None])[0]
            table.append({"percent": pct, "rpm": rpm, "ok": ok,
                          "note": note or ""})
    finally:
        # Put back what it was doing, in the same terms: a header that was in
        # full-speed mode goes back to full-speed mode, not to a manual 100%.
        was = before.get("mode")
        backend.set(was if was in ("auto", "full")
                    else str(before.get("percent", 50)))

    spinning = [row for row in table if (row["rpm"] or 0) > 0]
    result = {
        "device": dev["id"],
        "label": dev["label"],
        "table": table,
        "start_percent": spinning[0]["percent"] if spinning else None,
        "max_rpm": max((row["rpm"] or 0) for row in table) if table else 0,
        "min_rpm": min((row["rpm"] for row in spinning), default=None),
    }
    if not spinning:
        result["note"] = ("no tachometer reading at any duty: either nothing is "
                          "plugged into this header, or the fan has no sense wire")
    elif result["start_percent"] and result["start_percent"] > 0:
        result["note"] = ("this fan needs about %d%% to start; a curve that dips "
                          "below that will stall it"
                          % result["start_percent"])
    return result


