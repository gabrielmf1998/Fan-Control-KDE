<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Fan Control KDE</vendor>
  <vendor_url>https://github.com/gabrielmf1998/Fan-Control-KDE</vendor_url>

  <!-- Fans: speeds, curves, the boot and curve services. Changed constantly by
       the tray, and worth exactly nothing to an attacker who already has a
       session, so the shipped rules file lets wheel through without a prompt. -->
  <action id="io.github.gabrielmf1998.fancontrol">
    <description>Change fan speed</description>
    <description xml:lang="pt_BR">Alterar a velocidade das ventoinhas</description>
    <message>Authentication is required to change the fan speed</message>
    <message xml:lang="pt_BR">É necessário autenticar para alterar a velocidade das ventoinhas</message>
    <icon_name>fan-control-kde</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/fan-control-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Installing an update is a different kind of thing entirely: it puts new
       code on the machine as root. It is a separate action on a separate
       binary, it is not covered by the rules file above, and auth_admin means
       it asks every single time - no keep, no exceptions. -->
  <action id="io.github.gabrielmf1998.fancontrol.install">
    <description>Install a Fan Control KDE update</description>
    <description xml:lang="pt_BR">Instalar uma atualização do Fan Control KDE</description>
    <message>Authentication is required to install this update</message>
    <message xml:lang="pt_BR">É necessário autenticar para instalar esta atualização</message>
    <icon_name>fan-control-kde</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/fan-control-installer</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
