// Fan speed is not a security-sensitive setting and the tray changes it
// repeatedly, so members of wheel are not prompted for it. The action is bound
// to a single helper binary that touches nothing but fan controls, the curve
// file and its own two services.
//
// Deliberately not listed here: io.github.gabrielmf1998.fancontrol.install,
// which puts a package on the machine as root. That one asks every time, and
// adding it to this rule would turn "change a fan speed without a password"
// into "install anything without a password".
//
// Delete this file if you would rather authenticate every time; the fan action
// falls back to auth_admin_keep, which is one prompt per session.
polkit.addRule(function(action, subject) {
    if (action.id == "io.github.gabrielmf1998.fancontrol" && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
